/// Time of the last data refresh (shown in the report footer and the data quality page).
table _Refresh
	lineageTag: 6ba0a58b-8600-5209-a657-9e3d265576b7
	isHidden

	column RefreshedAt
		dataType: dateTime
		isHidden
		formatString: dd-mmm-yyyy hh:nn
		lineageTag: d561daf0-c34c-58bd-bcc4-4092ac7431a8
		summarizeBy: none
		sourceColumn: RefreshedAt

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition _Refresh = m
		mode: import
		source =
				let
				    Source = #table(type table [RefreshedAt = datetime], {{DateTime.LocalNow()}})
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
