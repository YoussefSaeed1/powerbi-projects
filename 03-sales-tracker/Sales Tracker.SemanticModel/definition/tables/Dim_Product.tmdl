		summarizeBy: none
		sourceColumn: ProductPrice

		annotation SummarizationSetBy = Automatic

	partition Dim_Product = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFilePath), null, true),
				    Sheet = Source{[Item="Products",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"ProductKey", "ProductName", "Subcategory", "Category", "ProductCost", "ProductPrice"}),
				    NonBlank = Table.SelectRows(Selected, each [ProductKey] <> null and [ProductKey] <> ""),
				    Typed = Table.TransformColumnTypes(NonBlank, {{"ProductKey", Int64.Type}, {"ProductName", type text}, {"Subcategory", type text}, {"Category", type text}, {"ProductCost", type number}, {"ProductPrice", type number}})
				in
				    Typed

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
