table Dim_Customer
	lineageTag: cb5914bc-d6b6-5015-b83b-3350fcfb77c2

	column CustomerKey
		dataType: int64
		isHidden
		isKey
		formatString: 0
		lineageTag: 2d20eff3-bb6f-5910-8f8f-347c6e3fbd28
		summarizeBy: none
		sourceColumn: CustomerKey

		annotation SummarizationSetBy = Automatic

	column Occupation
		dataType: string
		lineageTag: 29bd2cec-7a87-540a-8b93-0e60d6fe8401
		summarizeBy: none
		sourceColumn: Occupation

		annotation SummarizationSetBy = Automatic

	column TerritoryKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e260cb18-b287-53f5-9df1-eb439e3a50cb
		summarizeBy: none
		sourceColumn: TerritoryKey

		annotation SummarizationSetBy = Automatic

	partition Dim_Customer = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFilePath), null, true),
				    Sheet = Source{[Item="Customers",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"CustomerKey", "Occupation", "TerritoryKey"}),
				    NonBlank = Table.SelectRows(Selected, each [CustomerKey] <> null and [CustomerKey] <> ""),
				    Typed = Table.TransformColumnTypes(NonBlank, {{"CustomerKey", Int64.Type}, {"Occupation", type text}, {"TerritoryKey", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
