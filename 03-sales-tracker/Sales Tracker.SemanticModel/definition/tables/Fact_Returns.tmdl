/// Returned units by date, territory and product.
table Fact_Returns
	lineageTag: e34ea5f1-9b89-5de1-a450-105e30494c30

	column ReturnDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: dc512b91-85c2-5630-bb72-f20aed853015
		summarizeBy: none
		sourceColumn: ReturnDate

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column TerritoryKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ef737a15-3577-5e5b-9b2d-f0f930a0cb03
		summarizeBy: none
		sourceColumn: TerritoryKey

		annotation SummarizationSetBy = Automatic

	column ProductKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d1208b0f-abaa-5a98-b4d3-ec25e878d191
		summarizeBy: none
		sourceColumn: ProductKey

		annotation SummarizationSetBy = Automatic

	column ReturnQuantity
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 58d63b0c-5f60-52c3-82cb-2eae2dd0b3aa
		summarizeBy: none
		sourceColumn: ReturnQuantity

		annotation SummarizationSetBy = Automatic

	partition Fact_Returns = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFilePath), null, true),
				    Sheet = Source{[Item="Returns",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"ReturnDate", "TerritoryKey", "ProductKey", "ReturnQuantity"}),
				    NonBlank = Table.SelectRows(Selected, each [ReturnDate] <> null and [ReturnDate] <> ""),
				    Typed = Table.TransformColumnTypes(NonBlank, {{"ReturnDate", type date}, {"TerritoryKey", Int64.Type}, {"ProductKey", Int64.Type}, {"ReturnQuantity", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
