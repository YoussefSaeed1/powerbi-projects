/// Calendar from the first policy to the valuation date (end of the last claim year). Marked as the date table.
table Dim_Date
	lineageTag: a2d2771d-5e50-53e0-b998-96a896577bd0
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: e466328f-f8ab-5ab1-b1ca-ee2b215136a3
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: d6014747-6c5c-5d0c-ad88-c2c5a1eb46a4
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column MonthNo
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7db22ab9-fa9f-57e5-8c66-356c05f9618c
		summarizeBy: none
		sourceColumn: MonthNo

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		lineageTag: 4675b74d-1c38-5478-8a4c-eec7f004fe58
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: MonthNo

		annotation SummarizationSetBy = Automatic

	column YearMonthKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 54c4d3bd-58fd-5c82-a84f-51f005f8cf84
		summarizeBy: none
		sourceColumn: YearMonthKey

		annotation SummarizationSetBy = Automatic

	column 'Year-Month'
		dataType: string
		lineageTag: e2c03f7d-ea19-5eca-92d5-bc050c4e6c82
		summarizeBy: none
		sourceColumn: Year-Month
		sortByColumn: YearMonthKey

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = m
		mode: import
		source =
				let
				    Valuation = Date.EndOfYear(List.Max(Fact_Claims[LossDate])),
				    StartDate = Date.StartOfYear(List.Min(Fact_Policy[StartDate])),
				    Dates = List.Dates(StartDate, Duration.Days(Valuation - StartDate) + 1, #duration(1, 0, 0, 0)),
				    Base = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
				    Typed = Table.TransformColumnTypes(Base, {{"Date", type date}}),
				    AddYear = Table.AddColumn(Typed, "Year", each Date.Year([Date]), Int64.Type),
				    AddMonthNo = Table.AddColumn(AddYear, "MonthNo", each Date.Month([Date]), Int64.Type),
				    AddMonth = Table.AddColumn(AddMonthNo, "Month", each Date.ToText([Date], [Format="MMM", Culture="en-US"]), type text),
				    AddYMKey = Table.AddColumn(AddMonth, "YearMonthKey", each Date.Year([Date]) * 100 + Date.Month([Date]), Int64.Type),
				    AddYM = Table.AddColumn(AddYMKey, "Year-Month", each Date.ToText([Date], [Format="MMM yyyy", Culture="en-US"]), type text)
				in
				    AddYM

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
