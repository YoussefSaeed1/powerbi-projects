	partition Dim_Supplier = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFilePath), null, true),
				    Sheet = Source{[Item="Suppliers",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"SupplierID", "SupplierName", "Main_Category", "Origin", "Has_Contract"}),
				    NonBlank = Table.SelectRows(Selected, each [SupplierID] <> null and [SupplierID] <> ""),
				    Typed = Table.TransformColumnTypes(NonBlank, {{"SupplierID", type text}, {"SupplierName", type text}, {"Main_Category", type text}, {"Origin", type text}, {"Has_Contract", type logical}})
