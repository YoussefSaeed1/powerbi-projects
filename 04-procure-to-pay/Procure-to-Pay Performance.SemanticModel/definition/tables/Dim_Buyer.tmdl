table Dim_Buyer
	lineageTag: 5ca254de-1a00-559e-87d1-9f68b636b6e3

	column BuyerID
		dataType: string
		isHidden
		isKey
		lineageTag: e464bc1c-1e0d-592b-ad0c-179622b3ea0b
		summarizeBy: none
		sourceColumn: BuyerID

		annotation SummarizationSetBy = Automatic

	column BuyerName
		dataType: string
		lineageTag: 6426ea62-efa6-5989-87bc-c54fedcdb802
		summarizeBy: none
		sourceColumn: BuyerName

		annotation SummarizationSetBy = Automatic

	partition Dim_Buyer = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFilePath), null, true),
				    Sheet = Source{[Item="Buyers",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"BuyerID", "BuyerName"}),
				    NonBlank = Table.SelectRows(Selected, each [BuyerID] <> null and [BuyerID] <> ""),
				    Typed = Table.TransformColumnTypes(NonBlank, {{"BuyerID", type text}, {"BuyerName", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
