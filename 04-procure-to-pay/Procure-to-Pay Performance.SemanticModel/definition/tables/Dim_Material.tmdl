table Dim_Material
	lineageTag: 6b8f79ed-98e2-5ad2-9e89-8fbdec671a7d

	column MaterialID
		dataType: string
		isHidden
		isKey
		lineageTag: 794283c4-e45e-5221-b4d1-7787b051fe42
		summarizeBy: none
		sourceColumn: MaterialID

		annotation SummarizationSetBy = Automatic

	column MaterialName
		dataType: string
		lineageTag: 36fe8eb7-6261-5f18-9847-9dc04143f9f5
		summarizeBy: none
		sourceColumn: MaterialName

		annotation SummarizationSetBy = Automatic

	column Category
		dataType: string
		lineageTag: e6e990bd-c53a-503e-ae8b-4834ae272010
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = Automatic

	partition Dim_Material = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFilePath), null, true),
				    Sheet = Source{[Item="Materials",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"MaterialID", "MaterialName", "Category"}),
				    NonBlank = Table.SelectRows(Selected, each [MaterialID] <> null and [MaterialID] <> ""),
				    Typed = Table.TransformColumnTypes(NonBlank, {{"MaterialID", type text}, {"MaterialName", type text}, {"Category", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
