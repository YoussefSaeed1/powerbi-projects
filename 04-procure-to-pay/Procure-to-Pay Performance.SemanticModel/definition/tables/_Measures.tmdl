	measure 'KPI Suppliers' =
			VAR _a0 = ( "#0F4C5C" )
			VAR _n0 = ( "#66757D" )
			VAR _a1 = ( IF ( [Top 10 Supplier Share] > 0.4, "#E8A33D", "#0F4C5C" ) )
			VAR _n1 = ( "#66757D" )
			VAR _a2 = ( IF ( [On-Time Delivery %] >= [Target On-Time Delivery], "#3C8D5A", "#E8A33D" ) )
			VAR _n2 = ( IF ( [On-Time Delivery %] >= [On-Time Delivery % LY], "#3C8D5A", "#D2584E" ) )
			VAR _a3 = ( "#0F4C5C" )
			VAR _n3 = ( "#66757D" )
			VAR _a4 = ( "#0F4C5C" )
			VAR _n4 = ( IF ( [Avg Days PO to Receipt] <= [Avg Days PO to Receipt LY], "#3C8D5A", "#D2584E" ) )
			RETURN
			    "<div style='display:flex;gap:12px;height:78px;box-sizing:border-box;overflow:hidden;padding-bottom:2px;font-family:Segoe UI,sans-serif'>"
			    & "<div style='flex:1;min-width:0;background:#FFFFFF;border-radius:10px;padding:8px 14px 7px;box-shadow:0 1px 3px rgba(15,76,92,.10);display:flex;flex-direction:column;justify-content:space-between;border-top:3px solid " & _a0 & "'><div style='font-size:10.5px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:#66757D;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Active suppliers</div><div style='font-size:24px;font-weight:700;line-height:1.1;white-space:nowrap;color:#1C2B33'>" & ( FORMAT ( [Active Suppliers], "#,0" ) ) & "</div><div style='font-size:10.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _n0 & "'>" & ( VAR _d = [Active Suppliers] - [Active Suppliers LY] RETURN IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0" ) & " vs LY" ) & "</div></div>"
			    & "<div style='flex:1;min-width:0;background:#FFFFFF;border-radius:10px;padding:8px 14px 7px;box-shadow:0 1px 3px rgba(15,76,92,.10);display:flex;flex-direction:column;justify-content:space-between;border-top:3px solid " & _a1 & "'><div style='font-size:10.5px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:#66757D;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Top 10 share of spend</div><div style='font-size:24px;font-weight:700;line-height:1.1;white-space:nowrap;color:#1C2B33'>" & ( FORMAT ( [Top 10 Supplier Share], "0.0%" ) ) & "</div><div style='font-size:10.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _n1 & "'>" & ( "concentration risk" ) & "</div></div>"
			    & "<div style='flex:1;min-width:0;background:#FFFFFF;border-radius:10px;padding:8px 14px 7px;box-shadow:0 1px 3px rgba(15,76,92,.10);display:flex;flex-direction:column;justify-content:space-between;border-top:3px solid " & _a2 & "'><div style='font-size:10.5px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:#66757D;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>On-time delivery</div><div style='font-size:24px;font-weight:700;line-height:1.1;white-space:nowrap;color:#1C2B33'>" & ( FORMAT ( [On-Time Delivery %], "0.0%" ) ) & "</div><div style='font-size:10.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _n2 & "'>" & ( [OTD Note] ) & "</div></div>"
			    & "<div style='flex:1;min-width:0;background:#FFFFFF;border-radius:10px;padding:8px 14px 7px;box-shadow:0 1px 3px rgba(15,76,92,.10);display:flex;flex-direction:column;justify-content:space-between;border-top:3px solid " & _a3 & "'><div style='font-size:10.5px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:#66757D;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Quality acceptance</div><div style='font-size:24px;font-weight:700;line-height:1.1;white-space:nowrap;color:#1C2B33'>" & ( FORMAT ( [Quality Acceptance %], "0.0%" ) ) & "</div><div style='font-size:10.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _n3 & "'>" & ( "accepted vs ordered quantity" ) & "</div></div>"
			    & "<div style='flex:1;min-width:0;background:#FFFFFF;border-radius:10px;padding:8px 14px 7px;box-shadow:0 1px 3px rgba(15,76,92,.10);display:flex;flex-direction:column;justify-content:space-between;border-top:3px solid " & _a4 & "'><div style='font-size:10.5px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:#66757D;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Supplier lead time</div><div style='font-size:24px;font-weight:700;line-height:1.1;white-space:nowrap;color:#1C2B33'>" & ( FORMAT ( [Avg Days PO to Receipt], "0.0" ) & " d" ) & "</div><div style='font-size:10.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _n4 & "'>" & ( [Lead Time Note] ) & "</div></div>"
			    & "</div>"
		displayFolder: KPI Cards
		lineageTag: 440cebe7-c5ac-57f9-996c-f951520d52b1

	measure 'OTD Note' = VAR _d = ( [On-Time Delivery %] - [On-Time Delivery % LY] ) * 100 RETURN IF ( ISBLANK ( [On-Time Delivery % LY] ), "no prior year", IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0" ) & " pts vs LY" )
		displayFolder: KPI Text
		lineageTag: 4bca9c92-5b5f-501a-aa7a-e759eda2a061

	measure 'KPI Compliance' =
			VAR _a0 = ( IF ( [Maverick Spend %] > [Target Maverick Spend], "#D2584E", "#3C8D5A" ) )
			VAR _n0 = ( "#66757D" )
			VAR _a1 = ( "#0F4C5C" )
			VAR _n1 = ( IF ( [POs After Invoice] <= [POs After Invoice LY], "#3C8D5A", "#D2584E" ) )
			VAR _a2 = ( "#0F4C5C" )
			VAR _n2 = ( IF ( [First-Pass Match %] >= [First-Pass Match % LY], "#3C8D5A", "#D2584E" ) )
			VAR _a3 = ( IF ( [Late Payment %] > [Target Late Payments], "#E8A33D", "#3C8D5A" ) )
			VAR _n3 = ( "#66757D" )
			RETURN
			    "<div style='display:flex;gap:12px;height:78px;box-sizing:border-box;overflow:hidden;padding-bottom:2px;font-family:Segoe UI,sans-serif'>"
			    & "<div style='flex:1;min-width:0;background:#FFFFFF;border-radius:10px;padding:8px 14px 7px;box-shadow:0 1px 3px rgba(15,76,92,.10);display:flex;flex-direction:column;justify-content:space-between;border-top:3px solid " & _a0 & "'><div style='font-size:10.5px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:#66757D;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Maverick spend</div><div style='font-size:24px;font-weight:700;line-height:1.1;white-space:nowrap;color:#1C2B33'>" & ( FORMAT ( DIVIDE ( [Maverick Spend], 1000000 ), "$#,0.0" ) & "M" ) & "</div><div style='font-size:10.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _n0 & "'>" & ( FORMAT ( [Maverick Spend %], "0.0%" ) & " of spend" ) & "</div></div>"
			    & "<div style='flex:1;min-width:0;background:#FFFFFF;border-radius:10px;padding:8px 14px 7px;box-shadow:0 1px 3px rgba(15,76,92,.10);display:flex;flex-direction:column;justify-content:space-between;border-top:3px solid " & _a1 & "'><div style='font-size:10.5px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:#66757D;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>POs raised after the invoice</div><div style='font-size:24px;font-weight:700;line-height:1.1;white-space:nowrap;color:#1C2B33'>" & ( FORMAT ( [POs After Invoice], "#,0" ) ) & "</div><div style='font-size:10.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _n1 & "'>" & ( VAR _d = [POs After Invoice] - [POs After Invoice LY] RETURN IF ( _d <= 0, "▼ ", "▲ " ) & FORMAT ( ABS ( _d ), "0" ) & " vs LY" ) & "</div></div>"
			    & "<div style='flex:1;min-width:0;background:#FFFFFF;border-radius:10px;padding:8px 14px 7px;box-shadow:0 1px 3px rgba(15,76,92,.10);display:flex;flex-direction:column;justify-content:space-between;border-top:3px solid " & _a2 & "'><div style='font-size:10.5px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:#66757D;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>First-pass 3-way match</div><div style='font-size:24px;font-weight:700;line-height:1.1;white-space:nowrap;color:#1C2B33'>" & ( FORMAT ( [First-Pass Match %], "0.0%" ) ) & "</div><div style='font-size:10.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _n2 & "'>" & ( VAR _d = ( [First-Pass Match %] - [First-Pass Match % LY] ) * 100 RETURN IF ( ISBLANK ( [First-Pass Match % LY] ), "no prior year", IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0" ) & " pts vs LY" ) ) & "</div></div>"
			    & "<div style='flex:1;min-width:0;background:#FFFFFF;border-radius:10px;padding:8px 14px 7px;box-shadow:0 1px 3px rgba(15,76,92,.10);display:flex;flex-direction:column;justify-content:space-between;border-top:3px solid " & _a3 & "'><div style='font-size:10.5px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:#66757D;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Late payments</div><div style='font-size:24px;font-weight:700;line-height:1.1;white-space:nowrap;color:#1C2B33'>" & ( FORMAT ( [Late Payment %], "0.0%" ) ) & "</div><div style='font-size:10.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _n3 & "'>" & ( "target " & FORMAT ( [Target Late Payments], "0%" ) ) & "</div></div>"
			    & "</div>"
		displayFolder: KPI Cards
		lineageTag: 594bbb7c-3832-5fd9-8dd2-c506e6c44332

	measure 'Insight Compliance' =
			"<div style='font-family:Segoe UI,sans-serif;background:#0F4C5C;color:#E2EEF0;border-radius:10px;padding:12px 16px;box-sizing:border-box;height:100%;'><div style='font-size:12.5px;font-weight:700;margin:0 0 8px;color:#FFFFFF'>What the data says</div>"
			    & "<p style='font-size:12px;line-height:1.45;margin:0 0 7px'>" & ( "<b style='color:#F4B95A'>" & [Top Maverick Dept] & "</b>" & " is the department with the most spend outside the process: " & "<b style='color:#F4B95A'>" & FORMAT ( DIVIDE ( MAXX ( TOPN ( 1, ADDCOLUMNS ( VALUES ( Dim_Department[DepartmentName] ), "@m", [Maverick Spend] ), [@m], DESC ), [@m] ), 1000 ), "$#,0" ) & "K" & "</b>" & ", or " & FORMAT ( [Top Maverick Dept Share], "0%" ) & " of all maverick spend." ) & "</p>"
			    & "<p style='font-size:12px;line-height:1.45;margin:0 0 7px'>" & ( "Invoices that fail the first 3-way match are paid late more often: late payments run at " & "<b style='color:#F4B95A'>" & FORMAT ( [Late Payment %], "0.0%" ) & "</b>" & " overall." ) & "</p>"
			    & "</div>"
		displayFolder: Insights
		lineageTag: 32ce93b6-0675-5718-a6b6-f3331ca3a583

	measure 'DQ Summary' =
			"<div style='font-family:Segoe UI,sans-serif;background:#0F4C5C;color:#E2EEF0;border-radius:10px;padding:12px 16px;box-sizing:border-box;height:100%;'><div style='font-size:12.5px;font-weight:700;margin:0 0 8px;color:#FFFFFF'>How this report is governed</div>"
			    & "<p style='font-size:12px;line-height:1.45;margin:0 0 7px'>" & ( "<b>Data quality:</b> " & IF ( [DQ Failed Checks] = 0, "all checks pass on the last refresh.", FORMAT ( [DQ Failed Checks], "0" ) & " check(s) failed on the last refresh." ) ) & "</p>"
			    & "<p style='font-size:12px;line-height:1.45;margin:0 0 7px'>" & ( "<b>Security:</b> the Plant Manager role limits each manager to their own plant (row-level security on Dim_Plant). Leadership sees every plant." ) & "</p>"
			    & "<p style='font-size:12px;line-height:1.45;margin:0 0 7px'>" & ( "<b>Definitions:</b> every KPI is a documented measure with a description in the model, grouped in display folders." ) & "</p>"
			    & "<p style='font-size:12px;line-height:1.45;margin:0 0 7px'>" & ( "<b>Freshness:</b> " & [Last Refresh] & ". Latest PO in the data: " & FORMAT ( [Data As Of], "dd mmm yyyy" ) & "." ) & "</p>"
			    & "</div>"
		displayFolder: Insights
		lineageTag: 2c1125b3-669f-51f0-9236-7e05301119d4

	column Placeholder
		dataType: string
		isHidden
		lineageTag: 9df33aa6-f4f6-5c17-8635-6c15a643e424
		summarizeBy: none
		sourceColumn: Placeholder

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Placeholder = text], {})
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
