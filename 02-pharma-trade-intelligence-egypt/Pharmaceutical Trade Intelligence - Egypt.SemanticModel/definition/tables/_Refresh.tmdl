/// Time of the last data refresh (shown in the report footer and the data quality page).
table _Refresh
	lineageTag: 19cd1ad9-fc44-52c6-a70d-48e59c3f132f
	isHidden

	column RefreshedAt
		dataType: dateTime
		isHidden
		formatString: dd-mmm-yyyy hh:nn
		lineageTag: 7ab383c6-fcd3-5ed8-965b-00c80580b582
		summarizeBy: none
		sourceColumn: RefreshedAt

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition _Refresh = m
		mode: import
		source =
				let
				    Source = #table(type table [RefreshedAt = datetime], {{DateTime.LocalNow()}})
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
