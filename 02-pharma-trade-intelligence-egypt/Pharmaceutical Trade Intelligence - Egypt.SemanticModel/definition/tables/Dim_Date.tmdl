/// Calendar built from the fact dates; marked as the date table.
table Dim_Date
	lineageTag: 49f0f1de-a0c1-521f-81ca-e41801cdf8fa
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 95582401-9799-5fa8-8aee-9f7e09b65abf
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 3faae031-3148-5827-949b-d04d1e1e7f05
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column Quarter
		dataType: string
		lineageTag: 7a3ff5c2-675a-52bb-830e-921e5f89ca6f
		summarizeBy: none
		sourceColumn: Quarter

		annotation SummarizationSetBy = Automatic

	column MonthNo
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e2456fff-0b37-5071-bf97-fa3233c3d9bd
		summarizeBy: none
		sourceColumn: MonthNo

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		lineageTag: aa512aaf-4fd1-544e-9e30-545abf730e7a
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: MonthNo

		annotation SummarizationSetBy = Automatic

	column YearMonthKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 88054448-5974-58df-b7cc-3c8cbf2cd5cc
		summarizeBy: none
		sourceColumn: YearMonthKey

		annotation SummarizationSetBy = Automatic

	column 'Year-Month'
		dataType: string
		lineageTag: 92834c6c-2515-56fc-9cdf-4eeff5c4cc7d
		summarizeBy: none
		sourceColumn: Year-Month
		sortByColumn: YearMonthKey

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = m
		mode: import
		source =
				let
				    AllDates = List.RemoveNulls(List.Combine({Fact_Trade[Date]})),
				    StartDate = Date.StartOfYear(List.Min(AllDates)),
				    EndDate = Date.EndOfYear(List.Max(AllDates)),
				    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
				    Base = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
				    Typed = Table.TransformColumnTypes(Base, {{"Date", type date}}),
				    AddYear = Table.AddColumn(Typed, "Year", each Date.Year([Date]), Int64.Type),
				    AddQuarter = Table.AddColumn(AddYear, "Quarter", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
				    AddMonthNo = Table.AddColumn(AddQuarter, "MonthNo", each Date.Month([Date]), Int64.Type),
				    AddMonth = Table.AddColumn(AddMonthNo, "Month", each Date.ToText([Date], [Format="MMM", Culture="en-US"]), type text),
				    AddYMKey = Table.AddColumn(AddMonth, "YearMonthKey", each Date.Year([Date]) * 100 + Date.Month([Date]), Int64.Type),
				    AddYM = Table.AddColumn(AddYMKey, "Year-Month", each Date.ToText([Date], [Format="MMM yyyy", Culture="en-US"]), type text)
				in
				    AddYM

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
