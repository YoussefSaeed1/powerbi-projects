table _Measures
	lineageTag: 42d556b5-569c-5cc9-8230-f60bf2ff5e76

	measure 'Last Refresh' = "Data refreshed " & FORMAT ( MAX ( _Refresh[RefreshedAt] ), "dd mmm yyyy" )
		displayFolder: Helpers
		lineageTag: 73a18da6-cb2a-5c32-8b13-8dd6a797040d

	measure 'Selected Year' = MAX ( Dim_Date[Year] )
		formatString: 0
		displayFolder: Helpers
		lineageTag: 891d7d70-ddd7-5c18-a579-c9a9c55c9001

	/// List price before discounts.
	measure 'Gross Sales' = SUM ( Fact_Sales[Gross] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 97b4fde8-0e8a-5f62-8c2d-a11609288cd0

	measure Discounts = SUM ( Fact_Sales[Discount] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: c463fb56-898c-5d30-b8c7-f2e590335cee

	/// Gross sales minus discounts.
	measure 'Net Sales' = SUM ( Fact_Sales[NetSales] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 1a7e9de2-bac8-5155-a1c5-c89077c02271

	/// Parts cost and technician cost of the work sold.
	measure 'Cost of Sales' = SUM ( Fact_Sales[COGS] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 8fa036c6-3f75-5b2a-b6ad-928229af43e5

	measure 'Gross Profit' = [Net Sales] - [Cost of Sales]
		formatString: #,0
		displayFolder: Sales
		lineageTag: 64c3f03e-6963-59f6-be04-17840b565cc9

	measure 'Gross Margin' = DIVIDE ( [Gross Profit], [Net Sales] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 42932cf6-10da-5bbb-a1bf-48811d689125

	/// Discounts as a share of gross sales.
	measure 'Discount Rate' = DIVIDE ( [Discounts], [Gross Sales] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 35e3ed1c-c528-5cde-92f1-169f44d544e9

	measure Invoices = DISTINCTCOUNT ( Fact_Sales[InvoiceID] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: d123ca9f-7957-5d38-bac0-a4bbeb6b8c51

	measure 'Average Invoice' = DIVIDE ( [Net Sales], [Invoices] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: d9f0e104-166f-5f19-bfdd-af79e18c07b5

	/// Retail job cards: one workshop invoice is one visit.
	measure 'Workshop Visits' = CALCULATE ( DISTINCTCOUNT ( Fact_Sales[InvoiceID] ), Fact_Sales[Channel] = "Workshop" )
		formatString: #,0
		displayFolder: Sales
		lineageTag: c7ea21ab-b3fc-5a9b-823e-5fc5fab2a311

	measure 'Average Workshop Invoice' = DIVIDE ( CALCULATE ( [Net Sales], Fact_Sales[Channel] = "Workshop" ), [Workshop Visits] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 630ca252-a41c-5919-a96a-bf55aa97b6f8

	/// Technician hours billed on labour and body & paint lines.
	measure 'Hours Sold' = SUM ( Fact_Sales[Hours] )
		formatString: #,0
		displayFolder: Workshop
		lineageTag: 935f0a8d-cf0c-5d7d-8294-e1dc760851ee

	/// Labour net sales per hour sold, after discounts.
	measure 'Labour Sales per Hour' = DIVIDE ( CALCULATE ( [Net Sales], Dim_BusinessLine[Business Line] = "Labour" ), CALCULATE ( [Hours Sold], Dim_BusinessLine[Business Line] = "Labour" ) )
		formatString: #,0
		displayFolder: Workshop
		lineageTag: e312da24-ba6d-5fca-840d-f5a9e6540d7d

	/// Technicians × working days × 8 hours × 85%.
	measure 'Available Hours' = SUM ( Fact_Capacity[AvailableHours] )
		formatString: #,0
		displayFolder: Workshop
		lineageTag: 88794ba7-51ba-5480-8075-5c15d3820339

	/// Hours sold ÷ hours available. Above 95% the workshop turns work away.
	measure Utilisation = DIVIDE ( [Hours Sold], [Available Hours] )
		formatString: 0%
		displayFolder: Workshop
		lineageTag: 95ffacd6-26d6-5b0e-a255-15aab2afba7e

	measure 'Target Sales' = SUM ( Fact_BranchTarget[TargetSales] )
		formatString: #,0
		displayFolder: Targets
		lineageTag: e79d09f7-dcb1-535f-82f3-e61c3276def7

	measure 'Target Gross Profit' = SUM ( Fact_BranchTarget[TargetGP] )
		formatString: #,0
		displayFolder: Targets
		lineageTag: d25bf10e-78c4-5c16-a788-6703ca211b9c

	measure 'Sales vs Target' = DIVIDE ( [Net Sales], [Target Sales] )
		formatString: 0%
		displayFolder: Targets
		lineageTag: 11907aaa-4444-542b-8df2-13872d48a039

	measure 'Gross Profit vs Target' = DIVIDE ( [Gross Profit], [Target Gross Profit] )
		formatString: 0%
		displayFolder: Targets
		lineageTag: ec027861-b9ab-56a3-aa8f-97f28624424f

	measure 'Rep Target' = SUM ( Fact_RepTarget[TargetSales] )
		formatString: #,0
		displayFolder: Targets
		lineageTag: 5bb4e31c-1807-5021-a3ad-42834beb48fb

	/// Rep net sales ÷ rep target.
	measure 'Rep Achievement' = DIVIDE ( [Net Sales], [Rep Target] )
		formatString: 0%
		displayFolder: Targets
		lineageTag: 6aea0384-4382-55e9-aa67-07e328801715

	measure Overheads = SUM ( Fact_Overhead[Actual] )
		formatString: #,0
		displayFolder: Finance
		lineageTag: 450f869e-dd8f-56b2-be01-78f52b707647

	measure 'Overhead Budget' = SUM ( Fact_Overhead[Budget] )
		formatString: #,0
		displayFolder: Finance
		lineageTag: 89064d90-8f7d-55a5-845b-31a72650aec3

	measure 'Overheads vs Budget' = DIVIDE ( [Overheads], [Overhead Budget] ) - 1
		formatString: +0.0%;-0.0%
		displayFolder: Finance
		lineageTag: 2a0a2e8b-27a2-5d2d-af0e-2c6279f7f6ff

	/// Gross profit minus branch overheads.
	measure 'Operating Profit' = [Gross Profit] - [Overheads]
		formatString: #,0
		displayFolder: Finance
		lineageTag: 0171d5b6-76dc-5eac-bc5a-f8fd8ed7ec00

	measure 'Operating Margin' = DIVIDE ( [Operating Profit], [Net Sales] )
		formatString: 0.0%
		displayFolder: Finance
		lineageTag: 6582ca9f-f7c1-59a5-869f-25253c511628

	measure 'Gross Sales LY' = CALCULATE ( [Gross Sales], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) )
		formatString: #,0
		displayFolder: Last Year
		lineageTag: 04647e87-e3b0-5616-af1c-97c70536907f

	measure 'Discounts LY' = CALCULATE ( [Discounts], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) )
		formatString: #,0
		displayFolder: Last Year
		lineageTag: ad448080-b231-54ad-bf1f-b994de61ff94

	measure 'Net Sales LY' = CALCULATE ( [Net Sales], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) )
		formatString: #,0
		displayFolder: Last Year
		lineageTag: fb099283-e676-5926-b22a-1918c55e3c64

	measure 'Cost of Sales LY' = CALCULATE ( [Cost of Sales], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) )
		formatString: #,0
		displayFolder: Last Year
		lineageTag: 8798c0b6-158f-51e2-a0a8-e55178b34723

	measure 'Gross Profit LY' = CALCULATE ( [Gross Profit], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) )
		formatString: #,0
		displayFolder: Last Year
		lineageTag: 9bf010f4-31a5-5533-8065-bb1197957761

	measure 'Gross Margin LY' = CALCULATE ( [Gross Margin], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) )
		formatString: 0.0%
		displayFolder: Last Year
		lineageTag: e2d4fdd8-8c0e-5bc2-aa30-6c8435895acd

	measure 'Discount Rate LY' = CALCULATE ( [Discount Rate], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) )
		formatString: 0.0%
		displayFolder: Last Year
		lineageTag: 86fa6049-0e8a-59fc-9404-a1f3ca37bf2a

	measure 'Workshop Visits LY' = CALCULATE ( [Workshop Visits], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) )
		formatString: #,0
		displayFolder: Last Year
		lineageTag: 86830dd1-7766-5b0d-9d5d-29c7f0d580a2

	measure 'Average Workshop Invoice LY' = CALCULATE ( [Average Workshop Invoice], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) )
		formatString: #,0
		displayFolder: Last Year
		lineageTag: 780eb130-2757-517f-a90c-f92c5d91e126

	measure 'Hours Sold LY' = CALCULATE ( [Hours Sold], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) )
		formatString: #,0
		displayFolder: Last Year
		lineageTag: bfb0757f-abc6-558f-bd8c-41b1c110b7b6

	measure 'Operating Profit LY' = CALCULATE ( [Operating Profit], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) )
		formatString: #,0
		displayFolder: Last Year
		lineageTag: 667bc632-f40b-503a-ae28-a4c34c75acac

	measure 'Operating Margin LY' = CALCULATE ( [Operating Margin], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) )
		formatString: 0.0%
		displayFolder: Last Year
		lineageTag: 0e521e20-72e3-5395-9942-d1793d463db1

	/// Cars the group sold that are still on the road.
	measure 'Cars on Road' = SUM ( Fact_CarsOnRoad[CarsOnRoad] )
		formatString: #,0
		displayFolder: Network
		lineageTag: 5eef41ba-337e-5741-8ed7-8116cdba3e23

	/// Retail owners with at least one workshop visit in the period.
	measure 'Owners Visited' = CALCULATE ( DISTINCTCOUNT ( Fact_Sales[CustomerID] ), Fact_Sales[Channel] = "Workshop", Dim_Customer[CustomerType] = "Retail" )
		formatString: #,0
		displayFolder: Network
		lineageTag: 86ddbab8-3dca-529d-aa0f-9e0885612a7e

	/// Owners who visited ÷ our cars on the road.
	measure Penetration = DIVIDE ( [Owners Visited], [Cars on Road] )
		formatString: 0.0%
		displayFolder: Network
		lineageTag: 5408af05-8d18-5f8e-8ffa-209bc110d594

	measure 'Retail Customers' = CALCULATE ( DISTINCTCOUNT ( Fact_Sales[CustomerID] ), Dim_Customer[CustomerType] = "Retail" )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 3f9b3792-cd0d-5509-8b7c-bedd37161a19

	measure 'Retail Customers LY' = CALCULATE ( [Retail Customers], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 8ad76732-1dd2-5624-9c89-9aa122057be9

	/// Retail customers who bought last year and again this year.
	measure 'Retained Customers' =
			VAR _ly = CALCULATETABLE ( VALUES ( Fact_Sales[CustomerID] ), SAMEPERIODLASTYEAR ( Dim_Date[Date] ), Dim_Customer[CustomerType] = "Retail" )
			VAR _cy = CALCULATETABLE ( VALUES ( Fact_Sales[CustomerID] ), Dim_Customer[CustomerType] = "Retail" )
			RETURN
			    COUNTROWS ( INTERSECT ( _ly, _cy ) )
		formatString: #,0
		displayFolder: Customers
		lineageTag: da1c230e-39d8-5d17-88c8-b0f2d0862980

	measure 'Retention Rate' = DIVIDE ( [Retained Customers], [Retail Customers LY] )
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: 01b1a53b-d17a-534b-83c4-7ba364b6b637

	/// Bought last year, not this year.
	measure 'Lost Customers' = [Retail Customers LY] - [Retained Customers]
		formatString: #,0
		displayFolder: Customers
		lineageTag: 6b7068ad-7906-5561-b61d-6993f8c4e558

	/// Retail customers whose first purchase falls in the period.
	measure 'New Customers' =
			VAR _start = MIN ( Dim_Date[Date] )
			RETURN
			    COUNTROWS (
			        FILTER (
			            CALCULATETABLE ( VALUES ( Fact_Sales[CustomerID] ), Dim_Customer[CustomerType] = "Retail" ),
			            CALCULATE ( MIN ( Fact_Sales[InvoiceDate] ), REMOVEFILTERS ( Dim_Date ) ) >= _start
			        )
			    )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 579d887a-280b-53a4-9870-1eee0319fe8d

	measure 'Sales per Retail Customer' = DIVIDE ( CALCULATE ( [Net Sales], Dim_Customer[CustomerType] = "Retail" ), [Retail Customers] )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 267a2e75-2b89-52bb-a7f3-b7c398c0b85b

	/// Retention of owners whose car is this many years old in the selected year.
	measure 'Retention by Car Age' =
			VAR _y = MAX ( Dim_Date[Year] )
			VAR _a = SELECTEDVALUE ( Dim_CarAge[Car Age] )
			RETURN
			    CALCULATE ( [Retention Rate], FILTER ( ALL ( Dim_Customer[ModelYear] ), IF ( _a >= 8, Dim_Customer[ModelYear] <= _y - 8, Dim_Customer[ModelYear] = _y - _a ) ) )
		formatString: 0%
		displayFolder: Customers
		lineageTag: b4fea719-0f5a-5971-8fe5-c87a580ed563

	/// Retention of owners whose car is 1 or 2 years old.
	measure 'Retention In Warranty' = VAR _y = MAX ( Dim_Date[Year] ) RETURN CALCULATE ( [Retention Rate], FILTER ( ALL ( Dim_Customer[ModelYear] ), Dim_Customer[ModelYear] >= _y - 2 && Dim_Customer[ModelYear] <= _y - 1 ) )
		formatString: 0%
		displayFolder: Customers
		lineageTag: 6a9959c5-9d3b-5d6c-bd87-89e65d5dcbda

	/// Retention of owners whose car is 4 years or older (warranty ended).
	measure 'Retention After Warranty' = VAR _y = MAX ( Dim_Date[Year] ) RETURN CALCULATE ( [Retention Rate], FILTER ( ALL ( Dim_Customer[ModelYear] ), Dim_Customer[ModelYear] <= _y - 4 ) )
		formatString: 0%
		displayFolder: Customers
		lineageTag: fc4a4240-84f9-56f1-b08e-2d7afb6c5d28

	/// Owners of 3 to 5-year-old cars who bought last year and not this year.
	measure 'Lapsed Owners 3-5' =
			VAR _y = MAX ( Dim_Date[Year] )
			VAR _ly = CALCULATETABLE ( VALUES ( Fact_Sales[CustomerID] ), SAMEPERIODLASTYEAR ( Dim_Date[Date] ), Dim_Customer[CustomerType] = "Retail", Dim_Customer[ModelYear] >= _y - 5, Dim_Customer[ModelYear] <= _y - 3 )
			VAR _cy = CALCULATETABLE ( VALUES ( Fact_Sales[CustomerID] ), Dim_Customer[CustomerType] = "Retail" )
			VAR _lost = EXCEPT ( _ly, _cy )
			RETURN
			    COUNTROWS ( _lost )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 1bd0cb09-2c44-5014-a22f-2f32af2975fe

	/// What those owners spent with us last year.
	measure 'Lapsed Owners 3-5 Spend' =
			VAR _y = MAX ( Dim_Date[Year] )
			VAR _ly = CALCULATETABLE ( VALUES ( Fact_Sales[CustomerID] ), SAMEPERIODLASTYEAR ( Dim_Date[Date] ), Dim_Customer[CustomerType] = "Retail", Dim_Customer[ModelYear] >= _y - 5, Dim_Customer[ModelYear] <= _y - 3 )
			VAR _cy = CALCULATETABLE ( VALUES ( Fact_Sales[CustomerID] ), Dim_Customer[CustomerType] = "Retail" )
			VAR _lost = EXCEPT ( _ly, _cy )
			RETURN
			    SUMX ( _lost, CALCULATE ( [Net Sales], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) ) )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 19cd8925-5d65-5f76-94d8-1efe3f1ce13f

	/// Last year's spend of a lapsed owner with a 3 to 5-year-old car; blank for everyone else.
	measure 'Call List Spend' =
			VAR _y = MAX ( Dim_Date[Year] )
			VAR _my = SELECTEDVALUE ( Dim_Customer[ModelYear] )
			RETURN
			    IF (
			        HASONEVALUE ( Dim_Customer[CustomerID] )
			            && SELECTEDVALUE ( Dim_Customer[CustomerType] ) = "Retail"
			            && _y - _my >= 3 && _y - _my <= 5
			            && ISBLANK ( [Net Sales] ),
			        [Net Sales LY]
			    )
		formatString: #,0
		displayFolder: Customers
		lineageTag: ae10d4d4-58ec-56b7-884f-0f576d1236e6

	measure 'Call List Last Visit' = IF ( NOT ISBLANK ( [Call List Spend] ), CALCULATE ( MAX ( Fact_Sales[InvoiceDate] ), REMOVEFILTERS ( Dim_Date ) ) )
		formatString: dd mmm yyyy
		displayFolder: Customers
		lineageTag: 0bcf92bc-76b7-5ea0-89bb-347266120278

	/// Credit invoices issued and not yet paid at the end of the period.
	measure Receivables =
			VAR _d = MAX ( Dim_Date[Date] )
			RETURN
			    CALCULATE (
			        SUM ( Fact_Invoice[NetSales] ),
			        REMOVEFILTERS ( Dim_Date ),
			        Fact_Invoice[CreditTerms] > 0,
			        Fact_Invoice[InvoiceDate] <= _d,
			        FILTER ( ALL ( Fact_Invoice[PaidDate] ), ISBLANK ( Fact_Invoice[PaidDate] ) || Fact_Invoice[PaidDate] > _d )
			    )
		formatString: #,0
		displayFolder: Receivables
		lineageTag: fcc74aaa-d68e-5fb8-96d9-2faeae36dc01

	/// Receivables by days past the due date at the end of the period.
	measure 'Receivables Not Due' =
			VAR _d = MAX ( Dim_Date[Date] )
			RETURN
			    CALCULATE (
			        SUM ( Fact_Invoice[NetSales] ),
			        REMOVEFILTERS ( Dim_Date ),
			        Fact_Invoice[CreditTerms] > 0,
			        Fact_Invoice[InvoiceDate] <= _d,
			        FILTER ( ALL ( Fact_Invoice[PaidDate] ), ISBLANK ( Fact_Invoice[PaidDate] ) || Fact_Invoice[PaidDate] > _d ),
			        FILTER ( ALL ( Fact_Invoice[DueDate] ), _d - Fact_Invoice[DueDate] <= 0 )
			    )
		formatString: #,0
		displayFolder: Receivables
		lineageTag: 12df9055-bfc9-5a83-bcfb-8cf813752d83

	/// Receivables by days past the due date at the end of the period.
	measure 'Receivables 1-30 Days' =
			VAR _d = MAX ( Dim_Date[Date] )
			RETURN
			    CALCULATE (
			        SUM ( Fact_Invoice[NetSales] ),
			        REMOVEFILTERS ( Dim_Date ),
			        Fact_Invoice[CreditTerms] > 0,
			        Fact_Invoice[InvoiceDate] <= _d,
			        FILTER ( ALL ( Fact_Invoice[PaidDate] ), ISBLANK ( Fact_Invoice[PaidDate] ) || Fact_Invoice[PaidDate] > _d ),
			        FILTER ( ALL ( Fact_Invoice[DueDate] ), _d - Fact_Invoice[DueDate] > 0 && _d - Fact_Invoice[DueDate] <= 30 )
			    )
		formatString: #,0
		displayFolder: Receivables
		lineageTag: 3833616f-c180-5a09-b724-7f154c0eb7dd

	/// Receivables by days past the due date at the end of the period.
	measure 'Receivables 31-60 Days' =
			VAR _d = MAX ( Dim_Date[Date] )
			RETURN
			    CALCULATE (
			        SUM ( Fact_Invoice[NetSales] ),
			        REMOVEFILTERS ( Dim_Date ),
			        Fact_Invoice[CreditTerms] > 0,
			        Fact_Invoice[InvoiceDate] <= _d,
			        FILTER ( ALL ( Fact_Invoice[PaidDate] ), ISBLANK ( Fact_Invoice[PaidDate] ) || Fact_Invoice[PaidDate] > _d ),
			        FILTER ( ALL ( Fact_Invoice[DueDate] ), _d - Fact_Invoice[DueDate] > 30 && _d - Fact_Invoice[DueDate] <= 60 )
			    )
		formatString: #,0
		displayFolder: Receivables
		lineageTag: c731cb52-f758-58ce-90be-e5be566da7f7

	/// Receivables by days past the due date at the end of the period.
	measure 'Receivables 61-90 Days' =
			VAR _d = MAX ( Dim_Date[Date] )
			RETURN
			    CALCULATE (
			        SUM ( Fact_Invoice[NetSales] ),
			        REMOVEFILTERS ( Dim_Date ),
			        Fact_Invoice[CreditTerms] > 0,
			        Fact_Invoice[InvoiceDate] <= _d,
			        FILTER ( ALL ( Fact_Invoice[PaidDate] ), ISBLANK ( Fact_Invoice[PaidDate] ) || Fact_Invoice[PaidDate] > _d ),
			        FILTER ( ALL ( Fact_Invoice[DueDate] ), _d - Fact_Invoice[DueDate] > 60 && _d - Fact_Invoice[DueDate] <= 90 )
			    )
		formatString: #,0
		displayFolder: Receivables
		lineageTag: dd7a24cd-4b6a-5faa-a97c-eb47a6662dd7

	/// Receivables by days past the due date at the end of the period.
	measure 'Receivables Over 90 Days' =
			VAR _d = MAX ( Dim_Date[Date] )
			RETURN
			    CALCULATE (
			        SUM ( Fact_Invoice[NetSales] ),
			        REMOVEFILTERS ( Dim_Date ),
			        Fact_Invoice[CreditTerms] > 0,
			        Fact_Invoice[InvoiceDate] <= _d,
			        FILTER ( ALL ( Fact_Invoice[PaidDate] ), ISBLANK ( Fact_Invoice[PaidDate] ) || Fact_Invoice[PaidDate] > _d ),
			        FILTER ( ALL ( Fact_Invoice[DueDate] ), _d - Fact_Invoice[DueDate] > 90 )
			    )
		formatString: #,0
		displayFolder: Receivables
		lineageTag: 88947e32-72ba-5b0b-80bb-89b568303e4b

	/// Receivables by days past the due date at the end of the period.
	measure 'Receivables Overdue' =
			VAR _d = MAX ( Dim_Date[Date] )
			RETURN
			    CALCULATE (
			        SUM ( Fact_Invoice[NetSales] ),
			        REMOVEFILTERS ( Dim_Date ),
			        Fact_Invoice[CreditTerms] > 0,
			        Fact_Invoice[InvoiceDate] <= _d,
			        FILTER ( ALL ( Fact_Invoice[PaidDate] ), ISBLANK ( Fact_Invoice[PaidDate] ) || Fact_Invoice[PaidDate] > _d ),
			        FILTER ( ALL ( Fact_Invoice[DueDate] ), _d - Fact_Invoice[DueDate] > 0 )
			    )
		formatString: #,0
		displayFolder: Receivables
		lineageTag: e40bb96b-7997-56be-95e7-022518f95011

	measure 'Credit Sales' = CALCULATE ( SUM ( Fact_Invoice[NetSales] ), Fact_Invoice[CreditTerms] > 0 )
		formatString: #,0
		displayFolder: Receivables
		lineageTag: 5ba6fa7f-19ca-514e-9422-a62a3dfc2e64

	/// Receivables ÷ credit sales × days in the period.
	measure 'Days Sales Outstanding' = DIVIDE ( [Receivables], [Credit Sales] ) * COUNTROWS ( Dim_Date )
		formatString: 0
		displayFolder: Receivables
		lineageTag: 69cf91f9-bee5-5986-9422-0df2e471ac3a

	measure 'Role Median Discount' = VAR _r = SELECTEDVALUE ( Dim_Rep[Role] ) RETURN MEDIANX ( FILTER ( ALL ( Dim_Rep ), Dim_Rep[Role] = _r && NOT ISBLANK ( [Net Sales] ) ), [Discount Rate] )
		formatString: 0.0%
		displayFolder: Reps
		lineageTag: ebd198b9-195b-5d9b-b508-f8e050a7f34b

	measure 'Role Median Margin' = VAR _r = SELECTEDVALUE ( Dim_Rep[Role] ) RETURN MEDIANX ( FILTER ( ALL ( Dim_Rep ), Dim_Rep[Role] = _r && NOT ISBLANK ( [Net Sales] ) ), [Gross Margin] )
		formatString: 0.0%
		displayFolder: Reps
		lineageTag: f62578fe-314b-5b35-8ea3-3d2afdbae0b7

