	measure 'KPI Rep' =
			VAR _v0 = "EGP " & FORMAT ( DIVIDE ( [Net Sales], 1000000 ), "#,0.0" ) & "M"
			VAR _t0 = IF ( ISBLANK ( [Net Sales LY] ), "no prior year", IF ( [Net Sales] >= [Net Sales LY], "▲ ", "▼ " ) & FORMAT ( ABS ( DIVIDE ( [Net Sales], [Net Sales LY] ) - 1 ), "0.0%" ) & " vs " & ( MAX ( Dim_Date[Year] ) - 1 ) )
			VAR _c0 = IF ( ISBLANK ( [Net Sales LY] ), "#6B7178", IF ( [Net Sales] >= [Net Sales LY], "#2B8A6E", "#E8590C" ) )
			VAR _r0 = [Rep Achievement]
			VAR _v1 = FORMAT ( [Discount Rate], "0.0%" )
			VAR _t1 = "role median " & FORMAT ( [Role Median Discount], "0.0%" )
			VAR _c1 = IF ( [Discount Rate] > [Role Median Discount] * 1.25, "#E8590C", "#6B7178" )
			VAR _v2 = FORMAT ( [Gross Margin], "0.0%" )
			VAR _t2 = "role median " & FORMAT ( [Role Median Margin], "0.0%" )
			VAR _c2 = IF ( [Gross Margin] < [Role Median Margin] * 0.8, "#E8590C", "#6B7178" )
			VAR _v3 = FORMAT ( [Invoices], "#,0" )
			VAR _t3 = "average invoice EGP " & FORMAT ( [Average Invoice], "#,0" )
			VAR _c3 = "#6B7178"
			RETURN
			    "<div style='display:flex;height:90px;font-family:Segoe UI,sans-serif;color:#1D2125;background:#FFFFFF;border-radius:4px;overflow:hidden'>"
			    & "<div style='flex:1;min-width:0;position:relative;padding:11px 14px 0;'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#6B7178;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>NET SALES</div><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:25px;font-weight:600;line-height:1.1;margin-top:4px;white-space:nowrap'>" & _v0 & "</div><div style='font-size:10.5px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _c0 & "'>" & _t0 & "</div>" & IF ( NOT ISBLANK ( _r0 ), "<div style='position:absolute;left:14px;right:74px;bottom:11px;height:4px;background:#EEECE8'><div style='height:4px;width:" & FORMAT ( MIN ( _r0, 1.15 ) / 1.15 * 100, "0.0" ) & "%;background:" & IF ( _r0 < 0.95, "#E8590C", "#2B8A6E" ) & "'></div><div style='position:absolute;left:87%;top:-3px;width:2px;height:10px;background:#1D2125'></div></div><div style='position:absolute;right:12px;bottom:6px;font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;color:#6B7178'>" & FORMAT ( _r0, "0%" ) & " of target</div>" ) & "</div>"
			    & "<div style='flex:1;min-width:0;position:relative;padding:11px 14px 0;border-left:1px solid #E4E1DB;'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#6B7178;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>AVERAGE DISCOUNT</div><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:25px;font-weight:600;line-height:1.1;margin-top:4px;white-space:nowrap'>" & _v1 & "</div><div style='font-size:10.5px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _c1 & "'>" & _t1 & "</div>" & "</div>"
			    & "<div style='flex:1;min-width:0;position:relative;padding:11px 14px 0;border-left:1px solid #E4E1DB;'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#6B7178;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>GROSS MARGIN</div><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:25px;font-weight:600;line-height:1.1;margin-top:4px;white-space:nowrap'>" & _v2 & "</div><div style='font-size:10.5px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _c2 & "'>" & _t2 & "</div>" & "</div>"
			    & "<div style='flex:1;min-width:0;position:relative;padding:11px 14px 0;border-left:1px solid #E4E1DB;'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#6B7178;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>INVOICES</div><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:25px;font-weight:600;line-height:1.1;margin-top:4px;white-space:nowrap'>" & _v3 & "</div><div style='font-size:10.5px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _c3 & "'>" & _t3 & "</div>" & "</div>"
			    & "</div>"
		displayFolder: KPI Cards
		lineageTag: 22d5cca6-7f86-52e3-af27-a6090499ef87

	measure 'KPI Customers' =
			VAR _v0 = FORMAT ( [Retail Customers], "#,0" )
			VAR _t0 = "bought in the period"
			VAR _c0 = "#6B7178"
			VAR _v1 = FORMAT ( [Retention Rate], "0.0%" )
			VAR _t1 = "of last year's customers came back"
			VAR _c1 = "#6B7178"
			VAR _v2 = FORMAT ( [Lost Customers], "#,0" )
			VAR _t2 = "bought last year, not this year"
			VAR _c2 = "#E8590C"
			VAR _v3 = FORMAT ( [New Customers], "#,0" )
			VAR _t3 = "first purchase in the period"
			VAR _c3 = "#2B8A6E"
			VAR _v4 = "EGP " & FORMAT ( [Sales per Retail Customer], "#,0" )
			VAR _t4 = "retail customers"
			VAR _c4 = "#6B7178"
			RETURN
			    "<div style='display:flex;height:90px;font-family:Segoe UI,sans-serif;color:#1D2125;background:#FFFFFF;border-radius:4px;overflow:hidden'>"
			    & "<div style='flex:1;min-width:0;position:relative;padding:11px 14px 0;'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#6B7178;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>ACTIVE RETAIL CUSTOMERS</div><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:25px;font-weight:600;line-height:1.1;margin-top:4px;white-space:nowrap'>" & _v0 & "</div><div style='font-size:10.5px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _c0 & "'>" & _t0 & "</div>" & "</div>"
			    & "<div style='flex:1;min-width:0;position:relative;padding:11px 14px 0;border-left:1px solid #E4E1DB;'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#6B7178;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>RETENTION</div><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:25px;font-weight:600;line-height:1.1;margin-top:4px;white-space:nowrap'>" & _v1 & "</div><div style='font-size:10.5px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _c1 & "'>" & _t1 & "</div>" & "</div>"
			    & "<div style='flex:1;min-width:0;position:relative;padding:11px 14px 0;border-left:1px solid #E4E1DB;'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#6B7178;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>LOST THIS YEAR</div><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:25px;font-weight:600;line-height:1.1;margin-top:4px;white-space:nowrap'>" & _v2 & "</div><div style='font-size:10.5px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _c2 & "'>" & _t2 & "</div>" & "</div>"
			    & "<div style='flex:1;min-width:0;position:relative;padding:11px 14px 0;border-left:1px solid #E4E1DB;'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#6B7178;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>NEW CUSTOMERS</div><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:25px;font-weight:600;line-height:1.1;margin-top:4px;white-space:nowrap'>" & _v3 & "</div><div style='font-size:10.5px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _c3 & "'>" & _t3 & "</div>" & "</div>"
			    & "<div style='flex:1;min-width:0;position:relative;padding:11px 14px 0;border-left:1px solid #E4E1DB;'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#6B7178;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>SALES PER CUSTOMER</div><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:25px;font-weight:600;line-height:1.1;margin-top:4px;white-space:nowrap'>" & _v4 & "</div><div style='font-size:10.5px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _c4 & "'>" & _t4 & "</div>" & "</div>"
			    & "</div>"
		displayFolder: KPI Cards
		lineageTag: e43e7612-fdee-59b5-873d-3260276634ce

	measure 'KPI Finance' =
			VAR _v0 = "EGP " & FORMAT ( DIVIDE ( [Operating Profit], 1000000 ), "#,0.0" ) & "M"
			VAR _t0 = IF ( ISBLANK ( [Operating Profit LY] ), "no prior year", IF ( [Operating Profit] >= [Operating Profit LY], "▲ ", "▼ " ) & FORMAT ( ABS ( DIVIDE ( [Operating Profit], [Operating Profit LY] ) - 1 ), "0.0%" ) & " vs " & ( MAX ( Dim_Date[Year] ) - 1 ) )
			VAR _c0 = IF ( ISBLANK ( [Operating Profit LY] ), "#6B7178", IF ( [Operating Profit] >= [Operating Profit LY], "#2B8A6E", "#E8590C" ) )
			VAR _v1 = FORMAT ( [Operating Margin], "0.0%" )
			VAR _t1 = IF ( ISBLANK ( [Operating Margin LY] ), "no prior year", IF ( [Operating Margin] >= [Operating Margin LY], "▲ ", "▼ " ) & FORMAT ( ABS ( [Operating Margin] - [Operating Margin LY] ) * 100, "0.0" ) & " pts" & " vs " & ( MAX ( Dim_Date[Year] ) - 1 ) )
			VAR _c1 = IF ( ISBLANK ( [Operating Margin LY] ), "#6B7178", IF ( [Operating Margin] >= [Operating Margin LY], "#2B8A6E", "#E8590C" ) )
			VAR _v2 = "EGP " & FORMAT ( DIVIDE ( [Overheads], 1000000 ), "#,0.0" ) & "M"
			VAR _t2 = FORMAT ( ABS ( [Overheads vs Budget] ), "0.0%" ) & IF ( [Overheads vs Budget] > 0, " over budget", " under budget" )
			VAR _c2 = IF ( [Overheads vs Budget] > 0, "#E8590C", "#2B8A6E" )
			VAR _v3 = "EGP " & FORMAT ( DIVIDE ( [Receivables], 1000000 ), "#,0.0" ) & "M"
			VAR _t3 = FORMAT ( [Days Sales Outstanding], "0" ) & " days of credit sales"
			VAR _c3 = "#6B7178"
			VAR _v4 = "EGP " & FORMAT ( DIVIDE ( [Receivables Over 90 Days], 1000000 ), "#,0.0" ) & "M"
			VAR _t4 = FORMAT ( DIVIDE ( [Receivables Over 90 Days], [Receivables] ), "0%" ) & " of receivables"
			VAR _c4 = "#E8590C"
			RETURN
			    "<div style='display:flex;height:90px;font-family:Segoe UI,sans-serif;color:#1D2125;background:#FFFFFF;border-radius:4px;overflow:hidden'>"
			    & "<div style='flex:1;min-width:0;position:relative;padding:11px 14px 0;'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#6B7178;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>OPERATING PROFIT</div><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:25px;font-weight:600;line-height:1.1;margin-top:4px;white-space:nowrap'>" & _v0 & "</div><div style='font-size:10.5px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _c0 & "'>" & _t0 & "</div>" & "</div>"
			    & "<div style='flex:1;min-width:0;position:relative;padding:11px 14px 0;border-left:1px solid #E4E1DB;'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#6B7178;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>OPERATING MARGIN</div><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:25px;font-weight:600;line-height:1.1;margin-top:4px;white-space:nowrap'>" & _v1 & "</div><div style='font-size:10.5px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _c1 & "'>" & _t1 & "</div>" & "</div>"
			    & "<div style='flex:1;min-width:0;position:relative;padding:11px 14px 0;border-left:1px solid #E4E1DB;'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#6B7178;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>OVERHEADS</div><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:25px;font-weight:600;line-height:1.1;margin-top:4px;white-space:nowrap'>" & _v2 & "</div><div style='font-size:10.5px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _c2 & "'>" & _t2 & "</div>" & "</div>"
			    & "<div style='flex:1;min-width:0;position:relative;padding:11px 14px 0;border-left:1px solid #E4E1DB;'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#6B7178;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>RECEIVABLES</div><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:25px;font-weight:600;line-height:1.1;margin-top:4px;white-space:nowrap'>" & _v3 & "</div><div style='font-size:10.5px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _c3 & "'>" & _t3 & "</div>" & "</div>"
			    & "<div style='flex:1;min-width:0;position:relative;padding:11px 14px 0;border-left:1px solid #E4E1DB;'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:1.3px;color:#6B7178;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>OVER 90 DAYS LATE</div><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:25px;font-weight:600;line-height:1.1;margin-top:4px;white-space:nowrap'>" & _v4 & "</div><div style='font-size:10.5px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:" & _c4 & "'>" & _t4 & "</div>" & "</div>"
			    & "</div>"
		displayFolder: KPI Cards
		lineageTag: 2bff272e-98c4-5dc8-85e8-287c0465f3c8

	measure 'Best Margin Line' = MAXX ( TOPN ( 1, VALUES ( Dim_BusinessLine[Business Line] ), [Gross Margin], DESC ), Dim_BusinessLine[Business Line] )
		displayFolder: Insights
		lineageTag: 7bce1adb-8719-5134-97b6-c4a51fe9f2fc

	measure 'Story Overview' =
			VAR _g = DIVIDE ( [Net Sales], [Net Sales LY] ) - 1
			VAR _v = DIVIDE ( [Workshop Visits], [Workshop Visits LY] ) - 1
			VAR _t = DIVIDE ( [Average Workshop Invoice], [Average Workshop Invoice LY] ) - 1
			VAR _line = [Best Margin Line]
			VAR _ls = DIVIDE ( CALCULATE ( [Net Sales], Dim_BusinessLine[Business Line] = _line ), [Net Sales] )
			VAR _lg = DIVIDE ( CALCULATE ( [Gross Profit], Dim_BusinessLine[Business Line] = _line ), [Gross Profit] )
			VAR _ly = NOT ISBLANK ( [Net Sales LY] )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;background:#1D2125;color:#C3C8CD;font-size:11px;line-height:1.48;height:100%;overflow:hidden'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:2px;color:#8E959C;margin-bottom:4px'>WHAT WE FOUND</div>"
			    & IF ( _ly, "Net sales " & IF ( _g >= 0, "grew ", "fell " ) & "<b style='color:#FFFFFF;font-weight:600'>" & FORMAT ( ABS ( _g ), "0%" ) & "</b>" & " while workshop visits " & IF ( _v >= 0, "grew ", "fell " ) & "<b style='color:#FFFFFF;font-weight:600'>" & FORMAT ( ABS ( _v ), "0%" ) & "</b>" & ". The average workshop invoice " & IF ( _t >= 0, "rose ", "fell " ) & FORMAT ( ABS ( _t ), "0%" ) & ", so the growth came from prices, not more cars. ", "" )
			    & _line & " is " & FORMAT ( _ls, "0%" ) & " of sales and " & "<b style='color:#FFFFFF;font-weight:600'>" & FORMAT ( _lg, "0%" ) & "</b>" & " of gross profit. Gross profit reached " & FORMAT ( [Gross Profit vs Target], "0%" ) & " of target."
			    & "<div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:2px;color:#E8590C;margin:12px 0 4px'>RECOMMENDATION</div><div style='color:#FFFFFF'>"
			    & "Win back workshop visits before pushing parts volume: every lost visit takes " & LOWER ( _line ) & ", the most profitable line, with it."
			    & IF ( _ly && [Discount Rate] > [Discount Rate LY], " Bring the discount rate back to " & FORMAT ( [Discount Rate LY], "0.0%" ) & " from " & FORMAT ( [Discount Rate], "0.0%" ) & ".", "" )
			    & "</div></div>"
		displayFolder: Insights
		lineageTag: 56c8b5d7-5eef-50e2-987d-4ba55ee02356

	measure 'Story Geography' =
			VAR _low = [Lowest Region]
			VAR _lp = [Lowest Region Penetration]
			VAR _rest = [Other Regions Penetration]
			VAR _nb = [Cars Without Branch]
			VAR _nbp = CALCULATE ( [Penetration], Dim_Governorate[Has Branch] = 0 )
			VAR _top = MAXX ( TOPN ( 1, FILTER ( VALUES ( Dim_Governorate[Governorate] ), CALCULATE ( MAX ( Dim_Governorate[Has Branch] ) ) = 0 ), [Cars on Road], DESC ), Dim_Governorate[Governorate] )
			VAR _br = CALCULATETABLE ( VALUES ( Dim_Branch[Branch] ), Dim_Branch[Region] = _low, Dim_Branch[Technicians] > 0 )
			VAR _brn = MAXX ( _br, Dim_Branch[Branch] )
			VAR _u = CALCULATE ( [Utilisation], Dim_Branch[Region] = _low, REMOVEFILTERS ( Dim_Governorate ), REMOVEFILTERS ( Dim_Brand ) )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;background:#1D2125;color:#C3C8CD;font-size:11px;line-height:1.48;height:100%;overflow:hidden'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:2px;color:#8E959C;margin-bottom:4px'>WHAT WE FOUND</div>"
			    & "Outside " & _low & " about " & "<b style='color:#FFFFFF;font-weight:600'>" & FORMAT ( _rest, "0%" ) & "</b>" & " of our cars on the road come to the workshop each year; in " & _low & " only " & "<b style='color:#FFFFFF;font-weight:600'>" & FORMAT ( _lp, "0%" ) & "</b>" & ". "
			    & IF ( _nb > 0, [Governorates Without Branch] & " have " & FORMAT ( _nb, "#,0" ) & " of our cars and no branch, and " & FORMAT ( _nbp, "0%" ) & " of them visit. ", "" )
			    & IF ( COUNTROWS ( _br ) = 1, _brn & ", the only branch in " & _low & ", sells " & FORMAT ( _u, "0%" ) & " of its technician hours.", "" )
			    & "<div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:2px;color:#E8590C;margin:12px 0 4px'>RECOMMENDATION</div><div style='color:#FFFFFF'>"
			    & IF ( _nb > 0, "Plan a service point in " & _top & IF ( COUNTROWS ( _br ) = 1 && _u > 0.95, " and add technicians in " & _brn & ", which is already full", "" ) & ". Owners far from a branch are the largest group we are not serving.",
			        "Focus on " & _low & ": it has the lowest share of owners coming back." )
			    & "</div></div>"
		displayFolder: Insights
		lineageTag: d3f65db8-c161-5e6d-9fbc-b8600b7863fd

	measure 'Story Locations' =
			VAR _b = ADDCOLUMNS ( FILTER ( VALUES ( Dim_Branch[Branch] ), CALCULATE ( MAX ( Dim_Branch[Technicians] ) ) > 0 ), "@u", [Utilisation], "@op", [Operating Profit] )
			VAR _full = TOPN ( 1, _b, [@u], DESC )
			VAR _idle = TOPN ( 1, _b, [@u], ASC )
			VAR _fn = MAXX ( _full, Dim_Branch[Branch] )
			VAR _fu = MAXX ( _full, [@u] )
			VAR _in = MAXX ( _idle, Dim_Branch[Branch] )
			VAR _iu = MAXX ( _idle, [@u] )
			VAR _iop = MAXX ( _idle, [@op] )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;background:#1D2125;color:#C3C8CD;font-size:11px;line-height:1.48;height:100%;overflow:hidden'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:2px;color:#8E959C;margin-bottom:4px'>WHAT WE FOUND</div>"
			    & _fn & " sells " & "<b style='color:#FFFFFF;font-weight:600'>" & FORMAT ( _fu, "0%" ) & "</b>" & " of its technician hours" & IF ( _fu > 0.95, ": it is full and turning work away. ", ". " )
			    & _in & " sells " & "<b style='color:#FFFFFF;font-weight:600'>" & FORMAT ( _iu, "0%" ) & "</b>" & IF ( _iop < 0, " and loses EGP " & FORMAT ( - _iop / 1000000, "0.0" ) & "M", "" ) & ". "
			    & ( 0 + [Branches Losing Money] ) & " of " & COUNTROWS ( VALUES ( Dim_Branch[Branch] ) ) & " branches lose money after overheads."
			    & IF ( NOT ISBLANK ( [Online Growth] ), " Online parts orders grew " & FORMAT ( [Online Growth], "0%" ) & " but are " & FORMAT ( [Online Sales Share], "0.0%" ) & " of sales.", "" )
			    & "<div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:2px;color:#E8590C;margin:12px 0 4px'>RECOMMENDATION</div><div style='color:#FFFFFF'>"
			    & IF ( _fu > 0.95, "Add technicians or a second shift in " & _fn & ". ", "" ) & "At " & _in & ", move technicians to busier branches or cut fixed costs before adding anything else."
			    & "</div></div>"
		displayFolder: Insights
		lineageTag: e42cb715-1c4a-5832-a39a-fc4451c7f4db

	measure 'Story Rep' =
			VAR _rep = SELECTEDVALUE ( Dim_Rep[Rep] )
			VAR _a = [Rep Achievement]
			VAR _ma = [Role Median Achievement]
			VAR _d = [Discount Rate]
			VAR _md = [Role Median Discount]
			VAR _m = [Gross Margin]
			VAR _mm = [Role Median Margin]
			VAR _role = LOWER ( SELECTEDVALUE ( Dim_Rep[Role] ) )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;background:#1D2125;color:#C3C8CD;font-size:11px;line-height:1.48;height:100%;overflow:hidden'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:2px;color:#8E959C;margin-bottom:4px'>WHAT WE FOUND</div>"
			    & IF ( ISBLANK ( _rep ), "Select one rep to see their 360 view.",
			        _rep & " reached " & "<b style='color:#FFFFFF;font-weight:600'>" & FORMAT ( _a, "0%" ) & "</b>" & " of target (" & _role & " median " & FORMAT ( _ma, "0%" ) & ") with a " & "<b style='color:#FFFFFF;font-weight:600'>" & FORMAT ( _d, "0.0%" ) & "</b>" & " average discount against a " & FORMAT ( _md, "0.0%" ) & " median. Gross margin is " & FORMAT ( _m, "0.0%" ) & ", against " & FORMAT ( _mm, "0.0%" ) & " for the role." )
			    & "<div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:2px;color:#E8590C;margin:12px 0 4px'>RECOMMENDATION</div><div style='color:#FFFFFF'>"
			    & IF ( ISBLANK ( _rep ), "",
			        IF ( _d > _md * 1.5, "Coach on pricing, not volume: hold discounts to the role median. At the median, the same sales would have earned about EGP " & FORMAT ( ( _d - _md ) * [Gross Sales] / 1000000, "0.0" ) & "M more.",
			            IF ( _a < 0.9, "Coach on volume: " & _rep & " is " & FORMAT ( ( 1 - _a ) * 100, "0" ) & " pts below target with normal discounts.", "On track: no coaching needed on volume or discounts." ) ) )
			    & "</div></div>"
		displayFolder: Insights
		lineageTag: 9de02d2a-cdb6-5810-9441-a18ad311c1e8

	measure 'Story Customers' =
			VAR _in = [Retention In Warranty]
			VAR _out = [Retention After Warranty]
			VAR _n = [Lapsed Owners 3-5]
			VAR _v = [Lapsed Owners 3-5 Spend]
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;background:#1D2125;color:#C3C8CD;font-size:11px;line-height:1.48;height:100%;overflow:hidden'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:2px;color:#8E959C;margin-bottom:4px'>WHAT WE FOUND</div>"
			    & "Owners keep coming while the car is under warranty (" & "<b style='color:#FFFFFF;font-weight:600'>" & FORMAT ( _in, "0%" ) & "</b>" & " come back the next year). After the 3-year warranty ends, only " & "<b style='color:#FFFFFF;font-weight:600'>" & FORMAT ( _out, "0%" ) & "</b>" & " do. "
			    & FORMAT ( _n, "#,0" ) & " owners of 3 to 5-year-old cars did not come back this year; they spent EGP " & FORMAT ( _v / 1000000, "0.0" ) & "M with us last year."
			    & "<div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:2px;color:#E8590C;margin:12px 0 4px'>RECOMMENDATION</div><div style='color:#FFFFFF'>"
			    & "Call the list below first, highest spenders first, and offer a fixed-price service plan before the warranty ends, not after the owner has gone."
			    & "</div></div>"
		displayFolder: Insights
		lineageTag: 362081b4-aebe-596b-a32d-b45f33e1b6b9

	measure 'Story Finance' =
			VAR _g = DIVIDE ( [Net Sales], [Net Sales LY] ) - 1
			VAR _o = DIVIDE ( [Operating Profit], [Operating Profit LY] ) - 1
			VAR _over = TOPN ( 2, FILTER ( ADDCOLUMNS ( VALUES ( Fact_Overhead[Category] ), "@d", [Overheads] - [Overhead Budget] ), [@d] > 0 ), [@d], DESC )
			VAR _overTxt = CONCATENATEX ( _over, LOWER ( Fact_Overhead[Category] ), " and ", [@d], DESC )
			VAR _late = TOPN ( 2, FILTER ( ADDCOLUMNS ( VALUES ( Dim_Customer[CustomerType] ), "@l", [Receivables Over 90 Days] ), [@l] > 0 ), [@l], DESC )
			VAR _lateTxt = CONCATENATEX ( _late, LOWER ( Dim_Customer[CustomerType] ), " and ", [@l], DESC )
			VAR _save = ( [Discount Rate] - [Discount Rate LY] ) * [Gross Sales]
			VAR _ly = NOT ISBLANK ( [Net Sales LY] )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;background:#1D2125;color:#C3C8CD;font-size:11px;line-height:1.48;height:100%;overflow:hidden'><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:2px;color:#8E959C;margin-bottom:4px'>WHAT WE FOUND</div>"
			    & IF ( _ly, "Net sales " & IF ( _g >= 0, "rose ", "fell " ) & FORMAT ( ABS ( _g ), "0%" ) & " but operating profit " & IF ( _o >= 0, "rose ", "fell " ) & "<b style='color:#FFFFFF;font-weight:600'>" & FORMAT ( ABS ( _o ), "0%" ) & "</b>" & ", to EGP " & FORMAT ( [Operating Profit] / 1000000, "0.0" ) & "M. ", "" )
			    & "Discounts took EGP " & FORMAT ( [Discounts] / 1000000, "0.0" ) & "M and overheads ran " & "<b style='color:#FFFFFF;font-weight:600'>" & FORMAT ( ABS ( [Overheads vs Budget] ), "0.0%" ) & "</b>" & IF ( [Overheads vs Budget] > 0, " over budget", " under budget" ) & IF ( NOT ISEMPTY ( _over ), ", mostly " & _overTxt, "" ) & ". "
			    & "Customers owe EGP " & FORMAT ( [Receivables] / 1000000, "0.0" ) & "M" & IF ( NOT ISEMPTY ( _late ), "; " & _lateTxt & " hold most of the " & FORMAT ( [Receivables Over 90 Days] / 1000000, "0.0" ) & "M that is more than 90 days late.", "." )
			    & "<div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:9.5px;font-weight:600;letter-spacing:2px;color:#E8590C;margin:12px 0 4px'>RECOMMENDATION</div><div style='color:#FFFFFF'>"
			    & IF ( _ly && _save > 0, "Bring discounts back to last year's rate (worth about EGP " & FORMAT ( _save / 1000000, "0.0" ) & "M). ", "" )
			    & IF ( NOT ISEMPTY ( _over ), "Hold " & _overTxt & " to budget. ", "" )
			    & IF ( NOT ISEMPTY ( _late ), "Chase " & _lateTxt & " before extending more credit.", "" )
			    & "</div></div>"
		displayFolder: Insights
		lineageTag: 6cc66e4d-be68-5208-801e-6dc87f025566

	/// Each business line's share of net sales next to its share of gross profit; orange for the line that earns most above its weight.
	measure 'Line Mix' =
			VAR _ns = CALCULATE ( [Net Sales], REMOVEFILTERS ( Dim_BusinessLine ) )
			VAR _gp = CALCULATE ( [Gross Profit], REMOVEFILTERS ( Dim_BusinessLine ) )
			VAR _rows = ADDCOLUMNS ( VALUES ( Dim_BusinessLine[Business Line] ), "@s", DIVIDE ( [Net Sales], _ns ), "@g", DIVIDE ( [Gross Profit], _gp ) )
			VAR _top = MAXX ( TOPN ( 1, _rows, [@g] - [@s], DESC ), Dim_BusinessLine[Business Line] )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#1D2125;font-size:11.5px'>"
			        & "<div style='display:flex;color:#6B7178;font-size:10px;margin:0 0 6px 112px'><span style='width:110px'>share of sales</span><span>share of gross profit</span></div>"
			        & CONCATENATEX (
			            _rows,
			            VAR _hl = Dim_BusinessLine[Business Line] = _top
			            RETURN
			                "<div style='display:flex;align-items:center;height:41px'><div style='width:112px;font-weight:" & IF ( _hl, "600", "400" ) & "'>" & Dim_BusinessLine[Business Line] & "</div><div style='flex:1'>"
			                    & "<div style='display:flex;align-items:center;height:11px'><div style='height:8px;width:" & FORMAT ( [@s] * 200, "0" ) & "px;background:#C7CBCF'></div><span style='font-size:9.5px;color:#6B7178;padding-left:4px'>" & FORMAT ( [@s], "0%" ) & "</span></div>"
			                    & "<div style='display:flex;align-items:center;height:11px;margin-top:2px'><div style='height:8px;width:" & FORMAT ( MAX ( [@g], 0 ) * 200, "0" ) & "px;background:" & IF ( _hl, "#E8590C", "#3C4650" ) & "'></div><span style='font-size:9.5px;font-weight:700;padding-left:4px;color:" & IF ( _hl, "#E8590C", "#1D2125" ) & "'>" & FORMAT ( [@g], "0%" ) & "</span></div>"
			                    & "</div></div>",
			            "", [@s], DESC )
			        & "<div style='display:flex;gap:16px;margin:6px 0 0 112px;font-size:9.5px;color:#6B7178'><span><i style='display:inline-block;width:10px;height:6px;background:#C7CBCF;margin-right:4px'></i>share of sales</span><span><i style='display:inline-block;width:10px;height:6px;background:#3C4650;margin-right:4px'></i>share of gross profit</span></div></div>"
		displayFolder: KPI Cards
		lineageTag: 4a0dd149-66fb-5508-901d-826a1e7a665a

	/// Last year's gross profit, plus the change in gross sales, minus extra discounts and extra cost of sales, gives this year's.
	measure 'Gross Profit Bridge' =
			VAR _max = MAX ( MAX ( [Gross Profit LY], [Gross Profit] ), [Gross Profit LY] + [Gross Sales] - [Gross Sales LY] ) * 1.12
			VAR _t0 = [Gross Profit LY]
			VAR _b0 = 0
			VAR _t1 = [Gross Profit LY] + MAX ( [Gross Sales] - [Gross Sales LY], 0 )
			VAR _b1 = [Gross Profit LY] + MIN ( [Gross Sales] - [Gross Sales LY], 0 )
			VAR _t2 = [Gross Profit LY] + [Gross Sales] - [Gross Sales LY]
			VAR _b2 = [Gross Profit LY] + [Gross Sales] - [Gross Sales LY] - ( [Discounts] - [Discounts LY] )
			VAR _t3 = [Gross Profit LY] + [Gross Sales] - [Gross Sales LY] - ( [Discounts] - [Discounts LY] )
			VAR _b3 = [Gross Profit]
			VAR _t4 = [Gross Profit]
			VAR _b4 = 0
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#1D2125;display:flex;justify-content:space-between;padding:22px 20px 0'>"
			    & "<div style='width:120px;position:relative;height:150px;flex:none'><div style='position:absolute;left:0;width:120px;top:" & FORMAT ( ( 1 - _t0 / _max ) * 150, "0" ) & "px;height:" & FORMAT ( MAX ( ( _t0 - _b0 ) / _max * 150, 1.5 ), "0.0" ) & "px;background:#3C4650'></div><div style='position:absolute;left:-10px;right:-10px;text-align:center;top:" & FORMAT ( ( 1 - _t0 / _max ) * 150 - 17, "0" ) & "px;font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:12px;font-weight:600'>" & FORMAT ( DIVIDE ( [Gross Profit LY], 1000000 ), "#,0.0" ) & "M" & "</div><div style='position:absolute;left:-14px;right:-14px;text-align:center;top:156px;font-size:10px;color:#6B7178;line-height:1.2'>" & "Gross profit " & ( MAX ( Dim_Date[Year] ) - 1 ) & "</div></div>"
			    & "<div style='width:120px;position:relative;height:150px;flex:none'><div style='position:absolute;left:0;width:120px;top:" & FORMAT ( ( 1 - _t1 / _max ) * 150, "0" ) & "px;height:" & FORMAT ( MAX ( ( _t1 - _b1 ) / _max * 150, 1.5 ), "0.0" ) & "px;background:#2B8A6E'></div><div style='position:absolute;left:-10px;right:-10px;text-align:center;top:" & FORMAT ( ( 1 - _t1 / _max ) * 150 - 17, "0" ) & "px;font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:12px;font-weight:600'>" & IF ( [Gross Sales] >= [Gross Sales LY], "+", "" ) & FORMAT ( DIVIDE ( [Gross Sales] - [Gross Sales LY], 1000000 ), "#,0.0" ) & "M" & "</div><div style='position:absolute;left:-14px;right:-14px;text-align:center;top:156px;font-size:10px;color:#6B7178;line-height:1.2'>" & "Higher gross sales" & "</div></div>"
			    & "<div style='width:120px;position:relative;height:150px;flex:none'><div style='position:absolute;left:0;width:120px;top:" & FORMAT ( ( 1 - _t2 / _max ) * 150, "0" ) & "px;height:" & FORMAT ( MAX ( ( _t2 - _b2 ) / _max * 150, 1.5 ), "0.0" ) & "px;background:#E8590C'></div><div style='position:absolute;left:-10px;right:-10px;text-align:center;top:" & FORMAT ( ( 1 - _t2 / _max ) * 150 - 17, "0" ) & "px;font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:12px;font-weight:600'>" & FORMAT ( DIVIDE ( - ( [Discounts] - [Discounts LY] ), 1000000 ), "#,0.0" ) & "M" & "</div><div style='position:absolute;left:-14px;right:-14px;text-align:center;top:156px;font-size:10px;color:#6B7178;line-height:1.2'>" & "More discounts" & "</div></div>"
			    & "<div style='width:120px;position:relative;height:150px;flex:none'><div style='position:absolute;left:0;width:120px;top:" & FORMAT ( ( 1 - _t3 / _max ) * 150, "0" ) & "px;height:" & FORMAT ( MAX ( ( _t3 - _b3 ) / _max * 150, 1.5 ), "0.0" ) & "px;background:#E8590C'></div><div style='position:absolute;left:-10px;right:-10px;text-align:center;top:" & FORMAT ( ( 1 - _t3 / _max ) * 150 - 17, "0" ) & "px;font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:12px;font-weight:600'>" & FORMAT ( DIVIDE ( - ( [Cost of Sales] - [Cost of Sales LY] ), 1000000 ), "#,0.0" ) & "M" & "</div><div style='position:absolute;left:-14px;right:-14px;text-align:center;top:156px;font-size:10px;color:#6B7178;line-height:1.2'>" & "Higher cost of sales" & "</div></div>"
			    & "<div style='width:120px;position:relative;height:150px;flex:none'><div style='position:absolute;left:0;width:120px;top:" & FORMAT ( ( 1 - _t4 / _max ) * 150, "0" ) & "px;height:" & FORMAT ( MAX ( ( _t4 - _b4 ) / _max * 150, 1.5 ), "0.0" ) & "px;background:#3C4650'></div><div style='position:absolute;left:-10px;right:-10px;text-align:center;top:" & FORMAT ( ( 1 - _t4 / _max ) * 150 - 17, "0" ) & "px;font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:12px;font-weight:600'>" & FORMAT ( DIVIDE ( [Gross Profit], 1000000 ), "#,0.0" ) & "M" & "</div><div style='position:absolute;left:-14px;right:-14px;text-align:center;top:156px;font-size:10px;color:#6B7178;line-height:1.2'>" & "Gross profit " & MAX ( Dim_Date[Year] ) & "</div></div>"
			    & "</div>"
		displayFolder: KPI Cards
		lineageTag: 85e37450-30d8-5043-bedd-0fe06d6e51e0

	/// Monthly net sales as an index, first-year monthly average = 100. Ignores the year slicer.
	measure 'Sales Index' =
			VAR _m = SELECTEDVALUE ( Dim_Month[Month Start] )
			VAR _first = CALCULATE ( MIN ( Dim_Date[Year] ), REMOVEFILTERS ( Dim_Date ) )
			VAR _base = CALCULATE ( [Net Sales], REMOVEFILTERS ( Dim_Date ), Dim_Date[Year] = _first ) / 12
			RETURN
			    DIVIDE ( CALCULATE ( [Net Sales], REMOVEFILTERS ( Dim_Date ), Dim_Date[Month Start] = _m ), _base ) * 100
		formatString: 0
		displayFolder: Sales
		lineageTag: 46daf93a-b3c4-599a-951f-4e9b392e8dbd

	/// Monthly workshop visits as an index, first-year monthly average = 100. Ignores the year slicer.
	measure 'Visits Index' =
			VAR _m = SELECTEDVALUE ( Dim_Month[Month Start] )
			VAR _first = CALCULATE ( MIN ( Dim_Date[Year] ), REMOVEFILTERS ( Dim_Date ) )
			VAR _base = CALCULATE ( [Workshop Visits], REMOVEFILTERS ( Dim_Date ), Dim_Date[Year] = _first ) / 12
			RETURN
			    DIVIDE ( CALCULATE ( [Workshop Visits], REMOVEFILTERS ( Dim_Date ), Dim_Date[Month Start] = _m ), _base ) * 100
		formatString: 0
		displayFolder: Sales
		lineageTag: a8f9a2df-e9e8-5d68-a2f4-f6cb6c2d0580

	/// Map of Egypt: one circle per governorate sized by our cars on the road, coloured by penetration (orange = low); squares are service branches.
	measure 'Map Bubbles' =
			VAR _maxc = MAXX ( ALL ( Dim_Governorate[Governorate] ), [Cars on Road] )
			VAR _rows = ADDCOLUMNS ( VALUES ( Dim_Governorate[Governorate] ), "@c", [Cars on Road], "@p", [Penetration], "@x", ( 10 + ( CALCULATE ( MAX ( Dim_Governorate[Lon] ) ) - 24.6 ) * 34.127 ), "@y", ( 10 + ( 31.9 - CALCULATE ( MAX ( Dim_Governorate[Lat] ) ) ) * 38.2222 ), "@hb", CALCULATE ( MAX ( Dim_Governorate[Has Branch] ) ) )
			VAR _br = ADDCOLUMNS ( FILTER ( ALL ( Dim_Branch[Branch] ), CALCULATE ( MAX ( Dim_Branch[Technicians] ) ) > 0 ), "@x", ( 10 + ( CALCULATE ( MAX ( Dim_Branch[Lon] ) ) - 24.6 ) * 34.127 ), "@y", ( 10 + ( 31.9 - CALCULATE ( MAX ( Dim_Branch[Lat] ) ) ) * 38.2222 ) )
			RETURN
			    "<div style='position:relative;width:440px;height:510px;overflow:hidden;font-family:Segoe UI,sans-serif'>"
			        & CONCATENATEX (
			            _rows,
			            VAR _r = 4 + 20 * SQRT ( DIVIDE ( [@c], _maxc ) )
			            VAR _t = MAX ( 0, MIN ( 1, ( [@p] - 0.10 ) / 0.23 ) )
			            VAR _rgb = "rgb(" & ROUND ( 232 + ( 60 - 232 ) * _t, 0 ) & "," & ROUND ( 89 + ( 70 - 89 ) * _t, 0 ) & "," & ROUND ( 12 + ( 80 - 12 ) * _t, 0 ) & ")"
			            RETURN
			                "<div style='position:absolute;left:" & FORMAT ( [@x] - _r, "0" ) & "px;top:" & FORMAT ( [@y] - _r, "0" ) & "px;width:" & FORMAT ( 2 * _r, "0" ) & "px;height:" & FORMAT ( 2 * _r, "0" ) & "px;border-radius:50%;background:" & _rgb & ";opacity:.85;border:1px solid #FFFFFF;box-sizing:border-box'></div>"
			                    & IF ( [@hb] = 0 || [@p] < 0.25 || [@c] = _maxc,
			                        "<div style='position:absolute;left:" & FORMAT ( [@x] + _r + 4, "0" ) & "px;top:" & FORMAT ( [@y] - 8, "0" ) & "px;font-size:10.5px;font-weight:600;color:#1D2125;white-space:nowrap'>" & Dim_Governorate[Governorate] & " " & FORMAT ( [@p], "0%" ) & "</div>", "" ),
			            "", [@c], DESC )
			        & CONCATENATEX ( _br, "<div style='position:absolute;left:" & FORMAT ( [@x] - 3, "0" ) & "px;top:" & FORMAT ( [@y] - 3, "0" ) & "px;width:6px;height:6px;background:#FFFFFF;border:1.5px solid #1D2125'></div>", "" )
			        & "</div>"
		displayFolder: KPI Cards
		lineageTag: 3d9b863b-f039-56fc-a315-652ff42871cf

	/// Cars on the road, penetration, sales, growth and service branches by region of the customer.
	measure 'Region Table' =
			VAR _rows = ADDCOLUMNS ( VALUES ( Dim_Governorate[Region] ), "@c", [Cars on Road], "@p", [Penetration], "@s", [Net Sales], "@g", DIVIDE ( [Net Sales], [Net Sales LY] ) - 1 )
			VAR _low = MINX ( _rows, [@p] )
			VAR _gr = "display:grid;grid-template-columns:104px 50px 1fr 56px 46px 56px;align-items:center;column-gap:6px"
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#1D2125;font-size:11.5px'>"
			        & "<div style='" & _gr & ";color:#6B7178;font-size:10px;font-weight:600;padding-bottom:5px;border-bottom:1px solid #E4E1DB'><span>Region</span><span style='text-align:right'>Cars</span><span>Penetration</span><span style='text-align:right'>Sales</span><span style='text-align:right'>Growth</span><span style='text-align:right'>Branches</span></div>"
			        & CONCATENATEX (
			            _rows,
			            VAR _r = Dim_Governorate[Region]
			            VAR _hl = [@p] = _low
			            VAR _nb = CALCULATE ( COUNTROWS ( Dim_Branch ), Dim_Branch[Region] = _r, Dim_Branch[Technicians] > 0, REMOVEFILTERS ( Dim_Branch ) )
			            RETURN
			                "<div style='" & _gr & ";height:31px;border-bottom:1px solid #E4E1DB'><span style='font-weight:" & IF ( _hl, "600", "400" ) & "'>" & _r & "</span><span style='text-align:right'>" & FORMAT ( [@c], "#,0" ) & "</span>"
			                    & "<span style='display:flex;align-items:center'><i style='display:inline-block;height:10px;width:" & FORMAT ( [@p] * 220, "0" ) & "px;background:" & IF ( _hl, "#E8590C", "#3C4650" ) & "'></i><b style='padding-left:5px;font-size:10.5px;color:" & IF ( _hl, "#E8590C", "#1D2125" ) & "'>" & FORMAT ( [@p], "0%" ) & "</b></span>"
			                    & "<span style='text-align:right'>" & FORMAT ( [@s] / 1000000, "0.0" ) & "M</span><span style='text-align:right'>" & FORMAT ( [@g], "+0%;-0%" ) & "</span><span style='text-align:right'>" & ( 0 + _nb ) & "</span></div>",
			            "", [@c], DESC )
			        & "</div>"
		displayFolder: KPI Cards
		lineageTag: 2d1cf9cc-a334-5028-8cda-4d7ed119260d

	/// Penetration by governorate, lowest first; orange where there is no service branch.
	measure 'Governorate Bars' =
			VAR _rows = ADDCOLUMNS ( FILTER ( VALUES ( Dim_Governorate[Governorate] ), [Cars on Road] > 0 ), "@p", [Penetration], "@hb", CALCULATE ( MAX ( Dim_Governorate[Has Branch] ) ) )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#1D2125;font-size:10.5px'>"
			        & CONCATENATEX (
			            _rows,
			            VAR _no = [@hb] = 0
			            RETURN
			                "<div style='display:flex;align-items:center;height:24px'><div style='width:100px;text-align:right;padding-right:8px;font-weight:" & IF ( _no, "600", "400" ) & "'>" & Dim_Governorate[Governorate] & "</div>"
			                    & "<div style='height:12px;width:" & FORMAT ( [@p] * 700, "0" ) & "px;background:" & IF ( _no, "#E8590C", "#C7CBCF" ) & "'></div>"
			                    & "<div style='padding-left:6px;color:" & IF ( _no, "#E8590C", "#6B7178" ) & ";font-weight:" & IF ( _no, "600", "400" ) & "'>" & FORMAT ( [@p], "0%" ) & IF ( _no, "  no branch", "" ) & "</div></div>",
			            "", [@p], ASC )
			        & "</div>"
		displayFolder: KPI Cards
		lineageTag: 47c3cf62-b5da-59de-85a2-acaa07c5f84f

	/// Service branches: utilisation (x) against operating margin after overheads (y), circle size = net sales. Orange: full, or idle and losing money.
	measure 'Branch Scatter' =
			VAR _rows = ADDCOLUMNS ( FILTER ( VALUES ( Dim_Branch[Branch] ), CALCULATE ( MAX ( Dim_Branch[Technicians] ) ) > 0 ), "@u", [Utilisation], "@m", [Operating Margin], "@s", [Net Sales] )
			VAR _maxs = MAXX ( _rows, [@s] )
			VAR _W = 540
			VAR _H = 206
			VAR _Z = 8 + 0.16 / 0.40 * ( _H - 12 )
			RETURN
			    "<div style='position:relative;width:" & _W & "px;height:" & _H + 26 & "px;font-family:Segoe UI,sans-serif;color:#1D2125'>"
			        & "<div style='position:absolute;left:" & FORMAT ( 34 + 0.5 / 0.7 * ( _W - 44 ), "0" ) & "px;top:0;width:" & FORMAT ( 0.2 / 0.7 * ( _W - 44 ), "0" ) & "px;height:" & _H & "px;background:#FCEFE6'></div>"
			        & "<div style='position:absolute;left:34px;top:" & FORMAT ( _Z, "0" ) & "px;width:" & FORMAT ( 0.2 / 0.7 * ( _W - 44 ), "0" ) & "px;height:" & FORMAT ( _H - _Z, "0" ) & "px;background:#FCEFE6'></div>"
			        & "<div style='position:absolute;left:34px;right:10px;top:" & FORMAT ( _Z, "0" ) & "px;border-top:1px solid #C7CBCF'></div>"
			        & "<div style='position:absolute;right:14px;top:6px;font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:10px;font-weight:700;color:#E8590C'>FULL: ADD CAPACITY</div>"
			        & "<div style='position:absolute;left:40px;top:" & _H - 16 & "px;font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:10px;font-weight:700;color:#E8590C'>IDLE AND LOSING MONEY</div>"
			        & "<div style='position:absolute;left:0;top:2px;font-size:9px;color:#6B7178'>+16%</div><div style='position:absolute;left:8px;top:" & FORMAT ( _Z - 6, "0" ) & "px;font-size:9px;color:#6B7178'>0%</div><div style='position:absolute;left:0;top:" & _H - 8 & "px;font-size:9px;color:#6B7178'>-24%</div>"
			        & "<div style='position:absolute;top:212px;left:20px;width:28px;text-align:center;font-size:9px;color:#6B7178'>40%</div><div style='position:absolute;top:212px;left:162px;width:28px;text-align:center;font-size:9px;color:#6B7178'>60%</div><div style='position:absolute;top:212px;left:303px;width:28px;text-align:center;font-size:9px;color:#6B7178'>80%</div><div style='position:absolute;top:212px;left:445px;width:28px;text-align:center;font-size:9px;color:#6B7178'>100%</div>"
			        & CONCATENATEX (
			            _rows,
			            VAR _r = 5 + 13 * SQRT ( DIVIDE ( [@s], _maxs ) )
			            VAR _cx = 34 + ( MIN ( MAX ( [@u], 0.4 ), 1.1 ) - 0.4 ) / 0.7 * ( _W - 44 )
			            VAR _cy = 8 + ( 0.16 - MIN ( MAX ( [@m], -0.24 ), 0.16 ) ) / 0.40 * ( _H - 12 )
			            VAR _hl = [@u] > 0.95 || ( [@u] < 0.6 && [@m] < 0 )
			            RETURN
			                "<div style='position:absolute;left:" & FORMAT ( _cx - _r, "0" ) & "px;top:" & FORMAT ( _cy - _r, "0" ) & "px;width:" & FORMAT ( 2 * _r, "0" ) & "px;height:" & FORMAT ( 2 * _r, "0" ) & "px;border-radius:50%;border:1px solid #FFFFFF;box-sizing:border-box;background:" & IF ( _hl, "#E8590C", "#3C4650" ) & ";opacity:" & IF ( _hl, ".92", ".55" ) & "'></div>"
			                    & "<div style='position:absolute;left:" & FORMAT ( _cx - 60, "0" ) & "px;width:120px;text-align:center;top:" & FORMAT ( _cy - _r - 14, "0" ) & "px;font-size:9.5px;white-space:nowrap;color:" & IF ( _hl, "#1D2125", "#6B7178" ) & ";font-weight:" & IF ( _hl, "600", "400" ) & "'>" & Dim_Branch[Branch] & "</div>",
			            "", [@s], DESC )
			        & "</div>"
		displayFolder: KPI Cards
		lineageTag: 9379967f-5620-5f74-81ae-d3cc952bfa8f

	/// Net sales, growth and gross margin by channel; the fastest-growing channel in orange.
	measure 'Channel Table' =
			VAR _rows = ADDCOLUMNS ( VALUES ( Fact_Sales[Channel] ), "@s", [Net Sales], "@g", DIVIDE ( [Net Sales], [Net Sales LY] ) - 1, "@m", [Gross Margin] )
			VAR _max = MAXX ( _rows, [@s] )
			VAR _fast = MAXX ( TOPN ( 1, _rows, [@g], DESC ), Fact_Sales[Channel] )
			VAR _gr = "display:grid;grid-template-columns:96px 1fr 50px 44px;align-items:center;column-gap:6px"
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#1D2125;font-size:11.5px'>"
			        & "<div style='" & _gr & ";color:#6B7178;font-size:10px;font-weight:600;padding-bottom:4px'><span>Channel</span><span>Net sales</span><span style='text-align:right'>Growth</span><span style='text-align:right'>Margin</span></div>"
			        & CONCATENATEX (
			            _rows,
			            VAR _hl = Fact_Sales[Channel] = _fast
			            RETURN
			                "<div style='" & _gr & ";height:37px;border-top:1px solid #E4E1DB'><span style='font-weight:" & IF ( _hl, "600", "400" ) & "'>" & Fact_Sales[Channel] & "</span>"
			                    & "<span style='display:flex;align-items:center'><i style='display:inline-block;height:12px;width:" & FORMAT ( MAX ( [@s] / _max * 80, 1.5 ), "0.0" ) & "px;background:#3C4650'></i><span style='padding-left:5px;font-size:10px'>" & FORMAT ( [@s] / 1000000, "0.0" ) & "M</span></span>"
			                    & "<span style='text-align:right;font-weight:" & IF ( _hl, "700", "400" ) & ";color:" & IF ( _hl, "#E8590C", "#1D2125" ) & "'>" & IF ( ISBLANK ( [@g] ), "–", FORMAT ( [@g], "+0%;-0%" ) ) & "</span><span style='text-align:right'>" & FORMAT ( [@m], "0%" ) & "</span></div>",
			            "", [@s], DESC )
			        & "</div>"
		displayFolder: KPI Cards
		lineageTag: 226c013b-d616-520f-9dab-8b9f6e873853

	/// Every branch: sales, target, margin, workshop utilisation and operating profit after overheads.
	measure 'Branch Scorecard' =
			VAR _rows = ADDCOLUMNS ( VALUES ( Dim_Branch[Branch] ), "@s", [Net Sales], "@t", [Sales vs Target], "@gm", [Gross Margin], "@u", [Utilisation], "@op", [Operating Profit], "@om", [Operating Margin], "@g", DIVIDE ( [Net Sales], [Net Sales LY] ) - 1, "@tech", CALCULATE ( MAX ( Dim_Branch[Technicians] ) ), "@reg", CALCULATE ( MAX ( Dim_Branch[Region] ) ) )
			VAR _gr = "display:grid;grid-template-columns:118px 104px 70px 66px 78px 1fr 92px 74px 58px;align-items:center;column-gap:10px"
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#1D2125;font-size:10.5px'>"
			        & "<div style='" & _gr & ";color:#6B7178;font-size:9.5px;font-weight:600;padding-bottom:3px;border-bottom:1px solid #E4E1DB'><span>Branch</span><span>Region</span><span style='text-align:right'>Net sales</span><span style='text-align:right'>vs target</span><span style='text-align:right'>Gross margin</span><span>Utilisation</span><span style='text-align:right'>Op. profit</span><span style='text-align:right'>Op. margin</span><span style='text-align:right'>Growth</span></div>"
			        & CONCATENATEX (
			            _rows,
			            VAR _bad = [@op] < 0
			            VAR _ubad = [@u] > 0.95 || [@u] < 0.55
			            RETURN
			                "<div style='" & _gr & ";height:15.5px;border-bottom:1px solid #F1EFEB'><b style='font-weight:600'>" & Dim_Branch[Branch] & "</b><span style='color:#6B7178'>" & [@reg] & "</span><span style='text-align:right'>" & FORMAT ( [@s] / 1000000, "0.0" ) & "M</span>"
			                    & "<span style='text-align:right;color:" & IF ( [@t] < 0.85, "#E8590C", "#1D2125" ) & "'>" & FORMAT ( [@t], "0%" ) & "</span><span style='text-align:right'>" & FORMAT ( [@gm], "0.0%" ) & "</span>"
			                    & IF ( [@tech] > 0, "<span style='display:flex;align-items:center'><i style='display:inline-block;height:8px;width:" & FORMAT ( MIN ( [@u], 1.1 ) * 120, "0" ) & "px;background:" & IF ( _ubad, "#E8590C", "#C7CBCF" ) & "'></i><span style='padding-left:5px'>" & FORMAT ( [@u], "0%" ) & "</span></span>", "<span style='color:#6B7178'>parts outlet</span>" )
			                    & "<span style='text-align:right;color:" & IF ( _bad, "#E8590C", "#1D2125" ) & ";font-weight:" & IF ( _bad, "600", "400" ) & "'>" & FORMAT ( [@op] / 1000000, "0.00" ) & "M</span><span style='text-align:right;color:" & IF ( _bad, "#E8590C", "#1D2125" ) & "'>" & FORMAT ( [@om], "0.0%" ) & "</span><span style='text-align:right'>" & FORMAT ( [@g], "+0%;-0%" ) & "</span></div>",
			            "", [@s], DESC )
			        & "</div>"
		displayFolder: KPI Cards
		lineageTag: 52caa854-4b5e-5d83-ae42-faf931a6bd07

	/// Name, role, home branch and start year of the selected rep.
	measure 'Rep Card' =
			VAR _n = SELECTEDVALUE ( Dim_Rep[Rep] )
			VAR _sp = SEARCH ( " ", _n, 1, 0 )
			VAR _ini = LEFT ( _n, 1 ) & IF ( _sp > 0, MID ( _n, _sp + 1, 1 ), "" )
			RETURN
			    IF ( ISBLANK ( _n ),
			        "<div style='height:90px;background:#1D2125;border-radius:4px;color:#AEB4BA;font-family:Segoe UI,sans-serif;font-size:12px;display:flex;align-items:center;padding:0 16px'>Select one rep</div>",
			        "<div style='height:90px;background:#1D2125;border-radius:4px;display:flex;align-items:center;gap:12px;padding:0 16px;font-family:Segoe UI,sans-serif'>"
			            & "<div style='width:46px;height:46px;flex:none;border-radius:50%;background:#E8590C;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:17px;font-weight:700'>" & _ini & "</div>"
			            & "<div><div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:18px;font-weight:600;color:#FFFFFF'>" & _n & "</div><div style='font-size:10.5px;color:#AEB4BA;margin-top:2px'>" & SELECTEDVALUE ( Dim_Rep[Role] ) & " · " & SELECTEDVALUE ( Dim_Rep[Home Branch] ) & " · since " & SELECTEDVALUE ( Dim_Rep[HireYear] ) & "</div></div></div>" )
		displayFolder: KPI Cards
		lineageTag: dc37c71f-1eed-50d6-a3c9-302124d352b5

	/// Every rep: target achievement against average discount. Dark = same role as the selected rep, orange = the selected rep.
	measure 'Rep Scatter' =
			VAR _sel = SELECTEDVALUE ( Dim_Rep[RepID] )
			VAR _role = SELECTEDVALUE ( Dim_Rep[Role] )
			VAR _rows = FILTER ( ADDCOLUMNS ( ALL ( Dim_Rep ), "@a", [Rep Achievement], "@d", [Discount Rate] ), NOT ISBLANK ( [@a] ) )
			VAR _W = 520
			VAR _H = 270
			RETURN
			    "<div style='position:relative;width:" & _W & "px;height:" & _H + 22 & "px;font-family:Segoe UI,sans-serif;color:#1D2125'>"
			        & "<div style='position:absolute;left:36px;right:10px;top:" & FORMAT ( _H - ( 1 - 0.65 ) / 0.6 * _H, "0" ) & "px;border-top:1px dashed #C7CBCF'></div><div style='position:absolute;right:10px;top:" & FORMAT ( _H - ( 1 - 0.65 ) / 0.6 * _H - 14, "0" ) & "px;font-size:9px;color:#6B7178'>target</div>"
			        & "<div style='position:absolute;left:0;width:30px;text-align:right;top:242px;font-size:9px;color:#6B7178'>70%</div><div style='position:absolute;left:0;width:30px;text-align:right;top:106px;font-size:9px;color:#6B7178'>100%</div><div style='position:absolute;left:0;width:30px;text-align:right;top:16px;font-size:9px;color:#6B7178'>120%</div><div style='position:absolute;top:276px;left:22px;width:28px;text-align:center;font-size:9px;color:#6B7178'>0%</div><div style='position:absolute;top:276px;left:191px;width:28px;text-align:center;font-size:9px;color:#6B7178'>10%</div><div style='position:absolute;top:276px;left:361px;width:28px;text-align:center;font-size:9px;color:#6B7178'>20%</div>"
			        & "<div style='position:absolute;right:10px;top:" & _H - 16 & "px;font-size:9.5px;color:#6B7178'>discount given →</div>"
			        & CONCATENATEX (
			            FILTER ( _rows, Dim_Rep[RepID] <> _sel ),
			            VAR _cx = 36 + MIN ( [@d], 0.28 ) / 0.28 * ( _W - 46 )
			            VAR _cy = _H - ( MIN ( MAX ( [@a], 0.65 ), 1.25 ) - 0.65 ) / 0.6 * _H
			            RETURN
			                "<div style='position:absolute;left:" & FORMAT ( _cx - 5, "0" ) & "px;top:" & FORMAT ( _cy - 5, "0" ) & "px;width:10px;height:10px;border-radius:50%;background:" & IF ( Dim_Rep[Role] = _role, "#3C4650", "#C7CBCF" ) & ";opacity:.8'></div>",
			            "" )
			        & CONCATENATEX (
			            FILTER ( _rows, Dim_Rep[RepID] = _sel ),
			            VAR _cx = 36 + MIN ( [@d], 0.28 ) / 0.28 * ( _W - 46 )
			            VAR _cy = _H - ( MIN ( MAX ( [@a], 0.65 ), 1.25 ) - 0.65 ) / 0.6 * _H
			            RETURN
			                "<div style='position:absolute;left:" & FORMAT ( _cx - 8, "0" ) & "px;top:" & FORMAT ( _cy - 8, "0" ) & "px;width:16px;height:16px;border-radius:50%;background:#E8590C;border:2px solid #FFFFFF;box-sizing:border-box'></div>"
			                    & "<div style='position:absolute;left:" & FORMAT ( _cx - 170, "0" ) & "px;width:158px;text-align:right;top:" & FORMAT ( _cy - 22, "0" ) & "px;font-size:10.5px;font-weight:700;color:#E8590C'>" & Dim_Rep[Rep] & "</div>",
			            "" )
			        & "</div>"
		displayFolder: KPI Cards
		lineageTag: a346e821-9ea4-522d-977f-50e5198b6362

	/// The selected rep (orange) against every rep in the same role (grey dots) and the role median (black line), on four measures.
	measure 'Rep Strips' =
			VAR _sel = SELECTEDVALUE ( Dim_Rep[RepID] )
			VAR _role = SELECTEDVALUE ( Dim_Rep[Role] )
			VAR _n = SELECTEDVALUE ( Dim_Rep[Rep] )
			VAR _peers = FILTER ( ADDCOLUMNS ( FILTER ( ALL ( Dim_Rep ), Dim_Rep[Role] = _role ), "@s0", [Rep Achievement], "@s1", [Discount Rate], "@s2", [Gross Margin], "@s3", [Rep Growth] ), NOT ISBLANK ( [@s0] ) )
			VAR _v0 = [Rep Achievement]
			VAR _m0 = MEDIANX ( _peers, [@s0] )
			VAR _v1 = [Discount Rate]
			VAR _m1 = MEDIANX ( _peers, [@s1] )
			VAR _v2 = [Gross Margin]
			VAR _m2 = MEDIANX ( _peers, [@s2] )
			VAR _v3 = [Rep Growth]
			VAR _m3 = MEDIANX ( _peers, [@s3] )
			RETURN
			    IF ( ISBLANK ( _sel ), "<div style='font-family:Segoe UI,sans-serif;color:#6B7178;font-size:12px'>Select one rep</div>",
			        "<div style='font-family:Segoe UI,sans-serif;color:#1D2125;padding-top:4px'>" & "<div style='position:relative;height:72px'><div style='position:absolute;left:8px;top:0;font-size:11px;font-weight:600'>Target achievement</div><div style='position:absolute;right:16px;top:0;font-size:11px;font-weight:700;color:#E8590C'>" & _n & " " & FORMAT ( _v0, "0%" ) & "</div><div style='position:absolute;left:8px;width:358px;top:24px;height:10px;border-radius:5px;background:#E4E1DB'></div>" & CONCATENATEX ( FILTER ( _peers, Dim_Rep[RepID] <> _sel ), "<div style='position:absolute;left:" & FORMAT ( ( 8 + ( MIN ( MAX ( [@s0], 0.6 ), 1.3 ) - 0.6 ) / 0.7000000000000001 * 350 ) - 4, "0" ) & "px;top:25px;width:8px;height:8px;border-radius:50%;background:#3C4650;opacity:.45'></div>", "" ) & "<div style='position:absolute;left:" & FORMAT ( ( 8 + ( MIN ( MAX ( _m0, 0.6 ), 1.3 ) - 0.6 ) / 0.7000000000000001 * 350 ) - 1, "0" ) & "px;top:20px;width:2px;height:18px;background:#1D2125'></div><div style='position:absolute;left:" & FORMAT ( ( 8 + ( MIN ( MAX ( _m0, 0.6 ), 1.3 ) - 0.6 ) / 0.7000000000000001 * 350 ) - 50, "0" ) & "px;width:100px;text-align:center;top:40px;font-size:9px;color:#6B7178'>median " & FORMAT ( _m0, "0%" ) & "</div><div style='position:absolute;left:" & FORMAT ( ( 8 + ( MIN ( MAX ( _v0, 0.6 ), 1.3 ) - 0.6 ) / 0.7000000000000001 * 350 ) - 7, "0" ) & "px;top:22px;width:14px;height:14px;border-radius:50%;background:#E8590C;border:2px solid #FFFFFF;box-sizing:border-box'></div></div>" & "<div style='position:relative;height:72px'><div style='position:absolute;left:8px;top:0;font-size:11px;font-weight:600'>Average discount</div><div style='position:absolute;right:16px;top:0;font-size:11px;font-weight:700;color:#E8590C'>" & _n & " " & FORMAT ( _v1, "0%" ) & "</div><div style='position:absolute;left:8px;width:358px;top:24px;height:10px;border-radius:5px;background:#E4E1DB'></div>" & CONCATENATEX ( FILTER ( _peers, Dim_Rep[RepID] <> _sel ), "<div style='position:absolute;left:" & FORMAT ( ( 8 + ( MIN ( MAX ( [@s1], 0 ), 0.28 ) - 0 ) / 0.28 * 350 ) - 4, "0" ) & "px;top:25px;width:8px;height:8px;border-radius:50%;background:#3C4650;opacity:.45'></div>", "" ) & "<div style='position:absolute;left:" & FORMAT ( ( 8 + ( MIN ( MAX ( _m1, 0 ), 0.28 ) - 0 ) / 0.28 * 350 ) - 1, "0" ) & "px;top:20px;width:2px;height:18px;background:#1D2125'></div><div style='position:absolute;left:" & FORMAT ( ( 8 + ( MIN ( MAX ( _m1, 0 ), 0.28 ) - 0 ) / 0.28 * 350 ) - 50, "0" ) & "px;width:100px;text-align:center;top:40px;font-size:9px;color:#6B7178'>median " & FORMAT ( _m1, "0%" ) & "</div><div style='position:absolute;left:" & FORMAT ( ( 8 + ( MIN ( MAX ( _v1, 0 ), 0.28 ) - 0 ) / 0.28 * 350 ) - 7, "0" ) & "px;top:22px;width:14px;height:14px;border-radius:50%;background:#E8590C;border:2px solid #FFFFFF;box-sizing:border-box'></div></div>" & "<div style='position:relative;height:72px'><div style='position:absolute;left:8px;top:0;font-size:11px;font-weight:600'>Gross margin</div><div style='position:absolute;right:16px;top:0;font-size:11px;font-weight:700;color:#E8590C'>" & _n & " " & FORMAT ( _v2, "0%" ) & "</div><div style='position:absolute;left:8px;width:358px;top:24px;height:10px;border-radius:5px;background:#E4E1DB'></div>" & CONCATENATEX ( FILTER ( _peers, Dim_Rep[RepID] <> _sel ), "<div style='position:absolute;left:" & FORMAT ( ( 8 + ( MIN ( MAX ( [@s2], 0 ), 0.36 ) - 0 ) / 0.36 * 350 ) - 4, "0" ) & "px;top:25px;width:8px;height:8px;border-radius:50%;background:#3C4650;opacity:.45'></div>", "" ) & "<div style='position:absolute;left:" & FORMAT ( ( 8 + ( MIN ( MAX ( _m2, 0 ), 0.36 ) - 0 ) / 0.36 * 350 ) - 1, "0" ) & "px;top:20px;width:2px;height:18px;background:#1D2125'></div><div style='position:absolute;left:" & FORMAT ( ( 8 + ( MIN ( MAX ( _m2, 0 ), 0.36 ) - 0 ) / 0.36 * 350 ) - 50, "0" ) & "px;width:100px;text-align:center;top:40px;font-size:9px;color:#6B7178'>median " & FORMAT ( _m2, "0%" ) & "</div><div style='position:absolute;left:" & FORMAT ( ( 8 + ( MIN ( MAX ( _v2, 0 ), 0.36 ) - 0 ) / 0.36 * 350 ) - 7, "0" ) & "px;top:22px;width:14px;height:14px;border-radius:50%;background:#E8590C;border:2px solid #FFFFFF;box-sizing:border-box'></div></div>" & "<div style='position:relative;height:72px'><div style='position:absolute;left:8px;top:0;font-size:11px;font-weight:600'>Sales growth</div><div style='position:absolute;right:16px;top:0;font-size:11px;font-weight:700;color:#E8590C'>" & _n & " " & FORMAT ( _v3, "+0%;-0%" ) & "</div><div style='position:absolute;left:8px;width:358px;top:24px;height:10px;border-radius:5px;background:#E4E1DB'></div>" & CONCATENATEX ( FILTER ( _peers, Dim_Rep[RepID] <> _sel ), "<div style='position:absolute;left:" & FORMAT ( ( 8 + ( MIN ( MAX ( [@s3], -0.2 ), 0.8 ) - -0.2 ) / 1.0 * 350 ) - 4, "0" ) & "px;top:25px;width:8px;height:8px;border-radius:50%;background:#3C4650;opacity:.45'></div>", "" ) & "<div style='position:absolute;left:" & FORMAT ( ( 8 + ( MIN ( MAX ( _m3, -0.2 ), 0.8 ) - -0.2 ) / 1.0 * 350 ) - 1, "0" ) & "px;top:20px;width:2px;height:18px;background:#1D2125'></div><div style='position:absolute;left:" & FORMAT ( ( 8 + ( MIN ( MAX ( _m3, -0.2 ), 0.8 ) - -0.2 ) / 1.0 * 350 ) - 50, "0" ) & "px;width:100px;text-align:center;top:40px;font-size:9px;color:#6B7178'>median " & FORMAT ( _m3, "+0%;-0%" ) & "</div><div style='position:absolute;left:" & FORMAT ( ( 8 + ( MIN ( MAX ( _v3, -0.2 ), 0.8 ) - -0.2 ) / 1.0 * 350 ) - 7, "0" ) & "px;top:22px;width:14px;height:14px;border-radius:50%;background:#E8590C;border:2px solid #FFFFFF;box-sizing:border-box'></div></div>" & "</div>" )
		displayFolder: KPI Cards
		lineageTag: 5fe334d1-72ae-5f07-b749-711d2f20da4e

	/// Share of last year's retail customers who came back this year, by age of their car; orange after the 3-year warranty.
	measure 'Retention Bars' =
			VAR _rows = ADDCOLUMNS ( VALUES ( Dim_CarAge[Car Age] ), "@r", [Retention by Car Age], "@l", CALCULATE ( MAX ( Dim_CarAge[Car Age Label] ) ) )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#1D2125;display:flex;align-items:flex-end;height:228px;padding:0 10px 0 20px;position:relative'>"
			        & CONCATENATEX (
			            _rows,
			            VAR _after = Dim_CarAge[Car Age] >= 4
			            RETURN
			                "<div style='width:50px;margin-right:14px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:228px'>"
			                    & "<div style='font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:11.5px;font-weight:600;color:" & IF ( _after, "#E8590C", "#1D2125" ) & "'>" & FORMAT ( [@r], "0%" ) & "</div>"
			                    & "<div style='width:50px;margin-top:3px;height:" & FORMAT ( [@r] * 180, "0" ) & "px;background:" & IF ( _after, "#E8590C", "#3C4650" ) & "'></div>"
			                    & "<div style='font-size:10px;color:#6B7178;margin-top:6px'>" & [@l] & "</div></div>"
			                   ,
			            "", Dim_CarAge[Car Age], ASC )
			        & "<div style='position:absolute;left:" & FORMAT ( 20 + 3 * 64 - 7, "0" ) & "px;top:4px;height:204px;border-left:1.5px dashed #1D2125'></div><div style='position:absolute;left:" & FORMAT ( 20 + 3 * 64 - 1, "0" ) & "px;top:2px;font-size:10px;font-weight:600'>warranty ends (3 years)</div>"
			        & "</div><div style='font-family:Segoe UI,sans-serif;font-size:9.5px;color:#6B7178;padding:4px 0 0 20px'>Age of the car in years</div>"
		displayFolder: KPI Cards
		lineageTag: e9be860d-100f-5612-af71-50f717ef0ca1

	/// Net sales, growth and margin by customer type; margins under 20% in orange.
	measure 'Customer Types' =
			VAR _rows = ADDCOLUMNS ( VALUES ( Dim_Customer[CustomerType] ), "@s", [Net Sales], "@g", DIVIDE ( [Net Sales], [Net Sales LY] ) - 1, "@m", [Gross Margin], "@n", CALCULATE ( DISTINCTCOUNT ( Fact_Sales[CustomerID] ) ) )
			VAR _tot = SUMX ( _rows, [@s] )
			VAR _gr = "display:grid;grid-template-columns:1fr 70px 50px 46px;column-gap:6px"
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#1D2125;font-size:12px'>"
			        & "<div style='" & _gr & ";color:#6B7178;font-size:10px;font-weight:600;padding-bottom:4px'><span>Customer type</span><span style='text-align:right'>Net sales</span><span style='text-align:right'>Growth</span><span style='text-align:right'>Margin</span></div>"
			        & CONCATENATEX (
			            FILTER ( _rows, NOT ISBLANK ( [@s] ) ),
			            "<div style='" & _gr & ";border-top:1px solid #E4E1DB;padding:6px 0 5px'><div><b style='font-weight:600'>" & Dim_Customer[CustomerType] & "</b><div style='font-size:9.5px;color:#6B7178'>" & FORMAT ( [@n], "#,0" ) & " customers, " & FORMAT ( DIVIDE ( [@s], _tot ), "0%" ) & " of sales</div></div>"
			                & "<span style='text-align:right'>" & FORMAT ( [@s] / 1000000, "0.0" ) & "M</span><span style='text-align:right'>" & IF ( ISBLANK ( [@g] ), "–", FORMAT ( [@g], "+0%;-0%" ) ) & "</span><span style='text-align:right;font-weight:" & IF ( [@m] < 0.2, "700", "400" ) & ";color:" & IF ( [@m] < 0.2, "#E8590C", "#1D2125" ) & "'>" & FORMAT ( [@m], "0%" ) & "</span></div>",
			            "", [@s], DESC )
			        & "</div>"
		displayFolder: KPI Cards
		lineageTag: e886236b-1f55-5e9a-82bf-dd0ce2e37cf0

	/// Gross sales, minus discounts and cost of sales, gives gross profit; minus each overhead category gives operating profit. EGP.
	measure 'Profit Bridge' =
			VAR _cats = ADDCOLUMNS ( VALUES ( Fact_Overhead[Category] ), "@o", [Overheads] )
			VAR _gs = [Gross Sales]
			VAR _gp = [Gross Profit]
			VAR _max = _gs * 1.06
			VAR _H = 168
			VAR _col = "width:66px;position:relative;height:" & _H & "px;flex:none"
			VAR _bar = "position:absolute;left:0;width:66px"
			VAR _val = "position:absolute;left:-12px;right:-12px;text-align:center;font-family:Bahnschrift,DIN,Segoe UI,sans-serif;font-size:11px;font-weight:600"
			VAR _lab = "position:absolute;left:-14px;right:-14px;text-align:center;top:" & _H + 6 & "px;font-size:10px;color:#6B7178"
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#1D2125;display:flex;justify-content:space-between;padding:20px 22px 0'>"
			        & "<div style='" & _col & "'><div style='" & _bar & ";top:" & FORMAT ( ( 1 - _gs / _max ) * _H, "0" ) & "px;height:" & FORMAT ( _gs / _max * _H, "0" ) & "px;background:#3C4650'></div><div style='" & _val & ";top:" & FORMAT ( ( 1 - _gs / _max ) * _H - 16, "0" ) & "px'>" & FORMAT ( _gs / 1000000, "0" ) & "M</div><div style='" & _lab & "'>Gross sales</div></div>"
			        & "<div style='" & _col & "'><div style='" & _bar & ";top:" & FORMAT ( ( 1 - _gs / _max ) * _H, "0" ) & "px;height:" & FORMAT ( MAX ( [Discounts] / _max * _H, 1.5 ), "0.0" ) & "px;background:#E8590C'></div><div style='" & _val & ";top:" & FORMAT ( ( 1 - _gs / _max ) * _H - 16, "0" ) & "px'>" & FORMAT ( [Discounts] / 1000000, "0.0" ) & "M</div><div style='" & _lab & "'>Discounts</div></div>"
			        & "<div style='" & _col & "'><div style='" & _bar & ";top:" & FORMAT ( ( 1 - ( _gs - [Discounts] ) / _max ) * _H, "0" ) & "px;height:" & FORMAT ( [Cost of Sales] / _max * _H, "0" ) & "px;background:#E8590C'></div><div style='" & _val & ";top:" & FORMAT ( ( 1 - ( _gs - [Discounts] ) / _max ) * _H - 16, "0" ) & "px'>" & FORMAT ( [Cost of Sales] / 1000000, "0" ) & "M</div><div style='" & _lab & "'>Cost of sales</div></div>"
			        & "<div style='" & _col & "'><div style='" & _bar & ";top:" & FORMAT ( ( 1 - _gp / _max ) * _H, "0" ) & "px;height:" & FORMAT ( _gp / _max * _H, "0" ) & "px;background:#3C4650'></div><div style='" & _val & ";top:" & FORMAT ( ( 1 - _gp / _max ) * _H - 16, "0" ) & "px'>" & FORMAT ( _gp / 1000000, "0" ) & "M</div><div style='" & _lab & "'>Gross profit</div></div>"
			        & CONCATENATEX (
			            _cats,
			            VAR _me = [@o]
			            VAR _above = SUMX ( FILTER ( _cats, [@o] > _me ), [@o] )
			            VAR _top = _gp - _above
			            RETURN
			                "<div style='" & _col & "'><div style='" & _bar & ";top:" & FORMAT ( ( 1 - _top / _max ) * _H, "0" ) & "px;height:" & FORMAT ( MAX ( [@o] / _max * _H, 1.5 ), "0.0" ) & "px;background:#D99A6C'></div><div style='" & _val & ";top:" & FORMAT ( ( 1 - _top / _max ) * _H - 16, "0" ) & "px'>" & FORMAT ( [@o] / 1000000, "0.0" ) & "M</div><div style='" & _lab & "'>" & Fact_Overhead[Category] & "</div></div>",
			            "", [@o], DESC )
			        & "<div style='" & _col & "'><div style='" & _bar & ";top:" & FORMAT ( ( 1 - MAX ( [Operating Profit], 0 ) / _max ) * _H, "0" ) & "px;height:" & FORMAT ( MAX ( ABS ( [Operating Profit] ) / _max * _H, 1.5 ), "0.0" ) & "px;background:#1D2125'></div><div style='" & _val & ";top:" & FORMAT ( ( 1 - MAX ( [Operating Profit], 0 ) / _max ) * _H - 16, "0" ) & "px'>" & FORMAT ( [Operating Profit] / 1000000, "0.0" ) & "M</div><div style='" & _lab & "'>Operating profit</div></div>"
			        & "</div>"
		displayFolder: KPI Cards
		lineageTag: 01f8e5ff-695d-5a1a-ae4d-b200d2981245

	/// Overheads by category: bar = actual, black line = budget; orange more than 5% over budget.
	measure 'Overhead Bullets' =
			VAR _rows = ADDCOLUMNS ( VALUES ( Fact_Overhead[Category] ), "@a", [Overheads], "@b", [Overhead Budget] )
			VAR _max = MAXX ( _rows, MAX ( [@a], [@b] ) ) * 1.1
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#1D2125'>"
			        & CONCATENATEX (
			            _rows,
			            VAR _v = DIVIDE ( [@a], [@b] ) - 1
			            VAR _hl = _v > 0.05
			            RETURN
			                "<div style='display:flex;align-items:center;height:42px'><div style='width:100px'><div style='font-size:11.5px;font-weight:600'>" & Fact_Overhead[Category] & "</div><div style='font-size:9.5px;color:#6B7178'>budget " & FORMAT ( [@b] / 1000000, "0.0" ) & "M</div></div>"
			                    & "<div style='position:relative;width:240px;height:22px'><div style='position:absolute;left:0;top:3px;height:16px;width:" & FORMAT ( [@a] / _max * 240, "0" ) & "px;background:" & IF ( _hl, "#E8590C", "#C7CBCF" ) & "'></div><div style='position:absolute;top:0;width:2px;height:22px;background:#1D2125;left:" & FORMAT ( [@b] / _max * 240, "0" ) & "px'></div></div>"
			                    & "<div style='padding-left:4px;font-size:10.5px;font-weight:600;color:" & IF ( _hl, "#E8590C", "#6B7178" ) & "'>" & FORMAT ( _v, "+0.0%;-0.0%" ) & "</div></div>",
			            "", [@a], DESC )
			        & "</div>"
		displayFolder: KPI Cards
		lineageTag: b8ff8134-9c57-558d-8d52-b53a7099069d

	/// Open receivables at the end of the period by customer type and days past due.
	measure 'Receivables Aging' =
			VAR _rows = FILTER ( ADDCOLUMNS ( VALUES ( Dim_Customer[CustomerType] ), "@t", [Receivables], "@b0", [Receivables Not Due], "@b1", [Receivables 1-30 Days], "@b2", [Receivables 31-60 Days], "@b3", [Receivables 61-90 Days], "@b4", [Receivables Over 90 Days] ), [@t] > 0 )
			VAR _max = MAXX ( _rows, [@t] )
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#1D2125'>"
			        & CONCATENATEX (
			            _rows,
			            "<div style='display:flex;align-items:center;height:40px'><div style='width:90px;font-size:11.5px;font-weight:600'>" & Dim_Customer[CustomerType] & "</div><div style='display:flex;height:18px'>"
			                & "<div style='height:18px;background:#C7CBCF;width:" & FORMAT ( [@b0] / _max * 290, "0.0" ) & "px'></div>" & "<div style='height:18px;background:#A9AFB5;width:" & FORMAT ( [@b1] / _max * 290, "0.0" ) & "px'></div>" & "<div style='height:18px;background:#F2B48C;width:" & FORMAT ( [@b2] / _max * 290, "0.0" ) & "px'></div>" & "<div style='height:18px;background:#EE8A4F;width:" & FORMAT ( [@b3] / _max * 290, "0.0" ) & "px'></div>" & "<div style='height:18px;background:#E8590C;width:" & FORMAT ( [@b4] / _max * 290, "0.0" ) & "px'></div>"
			                & "</div><div style='padding-left:6px;font-size:10.5px;font-weight:600'>" & FORMAT ( [@t] / 1000000, "0.0" ) & "M</div></div>",
			            "", [@t], DESC )
			        & "<div style='display:flex;gap:12px;margin:16px 0 0 90px;font-size:9.5px;color:#6B7178'>" & "<span><i style='display:inline-block;width:10px;height:10px;background:#C7CBCF;margin-right:4px;vertical-align:-1px'></i>Not due</span>" & "<span><i style='display:inline-block;width:10px;height:10px;background:#A9AFB5;margin-right:4px;vertical-align:-1px'></i>1–30</span>" & "<span><i style='display:inline-block;width:10px;height:10px;background:#F2B48C;margin-right:4px;vertical-align:-1px'></i>31–60</span>" & "<span><i style='display:inline-block;width:10px;height:10px;background:#EE8A4F;margin-right:4px;vertical-align:-1px'></i>61–90</span>" & "<span><i style='display:inline-block;width:10px;height:10px;background:#E8590C;margin-right:4px;vertical-align:-1px'></i>90+</span>" & "</div>"
			        & "<div style='margin:6px 0 0 90px;font-size:9.5px;color:#6B7178'>days past the due date</div></div>"
		displayFolder: KPI Cards
		lineageTag: cc68d5b8-adf8-5d32-967e-5c87eb29aaa9

	column Placeholder
		dataType: string
		isHidden
		lineageTag: 4afa2b86-4f53-507f-a3db-176ce7729ba3
		summarizeBy: none
		sourceColumn: Placeholder

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Placeholder = text], {})
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
