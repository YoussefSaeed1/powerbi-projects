	partition Fact_Sales = m
		mode: import
		source =
				let
				    Header = Table.SelectColumns(Invoices_Raw, {"InvoiceID", "InvoiceDate", "BranchID", "CustomerID", "RepID", "Channel", "VehicleBrand"}),
				    Joined = Table.NestedJoin(Lines_Raw, {"InvoiceID"}, Header, {"InvoiceID"}, "H", JoinKind.Inner),
				    Expanded = Table.ExpandTableColumn(Joined, "H", {"InvoiceDate", "BranchID", "CustomerID", "RepID", "Channel", "VehicleBrand"}),
				    Kept = Table.SelectColumns(Expanded, {"LineID", "InvoiceID", "InvoiceDate", "BranchID", "CustomerID", "RepID", "Channel", "VehicleBrand", "BusinessLine", "Hours", "Gross", "Discount", "NetSales", "COGS"})
				in
