/// Customers: retail owners (with their car and model year) and business accounts (fleet, trade, insurance, government).
table Dim_Customer
	lineageTag: 1a376e6d-10e7-5ec9-a38d-3d8e6070a89d

	column CustomerID
		dataType: int64
		isHidden
		isKey
		formatString: 0
		lineageTag: 182c9e7c-6e18-5e0e-b600-9977410b9269
		summarizeBy: none
		sourceColumn: CustomerID

		annotation SummarizationSetBy = Automatic

	column Customer
		dataType: string
		lineageTag: bf01500b-66b0-50fe-a64d-1268124ed2ce
		summarizeBy: none
		sourceColumn: Customer

		annotation SummarizationSetBy = Automatic

	column CustomerType
		dataType: string
		lineageTag: d0a8bd23-a696-5485-b3fe-b39066b994a6
		summarizeBy: none
		sourceColumn: CustomerType

		annotation SummarizationSetBy = Automatic

	column Governorate
		dataType: string
		lineageTag: 0f852f4c-d65a-5446-be50-4065501e9d74
		summarizeBy: none
		sourceColumn: Governorate

		annotation SummarizationSetBy = Automatic

	column Car
		dataType: string
		lineageTag: bd949b55-e359-5c8b-a33a-e8de4adf553e
		summarizeBy: none
		sourceColumn: Car

		annotation SummarizationSetBy = Automatic

	column ModelYear
		dataType: int64
		formatString: 0
		lineageTag: 97345783-c6d3-5002-b76e-fb8ba675257d
		summarizeBy: none
		sourceColumn: ModelYear

		annotation SummarizationSetBy = Automatic

	column 'Nearest Branch'
		dataType: string
		lineageTag: 7872322d-0ccf-5d62-869c-c7738fc7f07b
		summarizeBy: none
		sourceColumn: Nearest Branch

		annotation SummarizationSetBy = Automatic

	column CreditTerms
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: cd6ad37c-b759-572c-9b78-10e6d8b58951
		summarizeBy: none
		sourceColumn: CreditTerms

		annotation SummarizationSetBy = Automatic

	partition Dim_Customer = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFilePath), null, true),
				    Sheet = Source{[Item="Customers",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"CustomerID", Int64.Type}, {"CustomerName", type text}, {"CustomerType", type text}, {"Governorate", type text}, {"VehicleBrand", type text}, {"ModelYear", Int64.Type}, {"CreditTerms", Int64.Type}}),
				    Named = Table.AddColumn(Typed, "Customer", each if [CustomerType] = "Retail" then "C-" & Text.From([CustomerID]) else [CustomerName], type text),
				    Near = Table.NestedJoin(Named, {"Governorate"}, Dim_Governorate, {"Governorate"}, "G", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Near, "G", {"Nearest Branch"}),
				    Renamed = Table.RenameColumns(Expanded, {{"VehicleBrand", "Car"}}),
				    Kept = Table.SelectColumns(Renamed, {"CustomerID", "Customer", "CustomerType", "Governorate", "Car", "ModelYear", "Nearest Branch", "CreditTerms"})
				in
				    Kept

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
