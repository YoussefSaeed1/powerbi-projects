/// All months, not related to anything: the sales-and-visits chart always shows every month, whatever year is selected.
table Dim_Month
	lineageTag: 841e44a9-fc40-5ce6-ad80-2e50ace61cee

	column 'Month Start'
		dataType: dateTime
		isKey
		formatString: mmm yyyy
		lineageTag: b588fc96-786c-5efc-ae3c-f24a3d5263ee
		summarizeBy: none
		sourceColumn: Month Start

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition Dim_Month = m
		mode: import
		source =
				let
				    Source = Table.Distinct(Table.SelectColumns(Dim_Date, {"Month Start"}))
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
