	partition Dim_Branch = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFilePath), null, true),
				    Sheet = Source{[Item="Branches",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"BranchID", "Branch", "City", "Governorate", "Region", "Lat", "Lon", "BranchType", "Bays", "Technicians", "BranchManagerEmail"}),
				    NonBlank = Table.SelectRows(Selected, each [BranchID] <> null and [BranchID] <> ""),
				    Typed = Table.TransformColumnTypes(NonBlank, {{"BranchID", Int64.Type}, {"Branch", type text}, {"City", type text}, {"Governorate", type text}, {"Region", type text}, {"Lat", type number}, {"Lon", type number}, {"BranchType", type text}, {"Bays", Int64.Type}, {"Technicians", Int64.Type}, {"BranchManagerEmail", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
