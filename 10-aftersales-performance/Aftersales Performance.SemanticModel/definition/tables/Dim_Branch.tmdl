/// Branches with location, type and workshop size. BranchManagerEmail drives row-level security.
table Dim_Branch
	lineageTag: 0593c7d3-7fad-5746-b868-ab7ea82be441

	column BranchID
		dataType: int64
		isHidden
		isKey
		formatString: 0
		lineageTag: e6b33303-e341-598b-9ded-8f03b59f3c4f
		summarizeBy: none
