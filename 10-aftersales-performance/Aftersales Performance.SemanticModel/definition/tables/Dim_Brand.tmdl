/// Car brands we sell and service.
table Dim_Brand
	lineageTag: 6d5c1518-a1b1-52d4-bc6e-2b32a089db27

	column Brand
		dataType: string
		isKey
		lineageTag: e1897f7e-2f1d-58cc-bb0a-067b6e0477eb
		summarizeBy: none
		sourceColumn: Brand

		annotation SummarizationSetBy = Automatic

	partition Dim_Brand = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFilePath), null, true),
				    Sheet = Source{[Item="CarsOnRoad",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Brands = Table.Distinct(Table.SelectColumns(Promoted, {"VehicleBrand"})),
				    Renamed = Table.RenameColumns(Brands, {{"VehicleBrand", "Brand"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Brand", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
