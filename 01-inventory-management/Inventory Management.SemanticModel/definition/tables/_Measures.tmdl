	/// Rank of the product by revenue in the year in focus.
	measure 'Product Rank' = IF ( NOT ISBLANK ( [Revenue CY] ), RANKX ( ALLSELECTED ( Products[ProductName] ), [Revenue CY], , DESC, DENSE ) )
		formatString: 0
