table _Measures
	lineageTag: 4882acc7-c045-5b48-a8d7-e3296250b38f

	/// Result of each data quality rule in Dim_DQ.
	measure 'DQ Value' =
			VAR _o = SELECTEDVALUE ( Dim_DQ[Check Order] )
			RETURN
			    SWITCH (
			        _o,
			        1, FORMAT ( 0 + COUNTROWS ( ALL ( Fact_Sales ) ), "#,0" ),
			        2, FORMAT ( 0 + COUNTROWS ( ALL ( Fact_Inventory ) ), "#,0" ),
			        3, FORMAT ( 0 + COUNTROWS ( ALL ( Fact_PurchaseOrders ) ), "#,0" ),
			        4, FORMAT ( 0 + COUNTROWS ( ALL ( Products ) ) - CALCULATE ( DISTINCTCOUNT ( Products[SKU] ), ALL ( Products ) ), "#,0" ),
			        5, FORMAT ( 0 + COUNTROWS ( FILTER ( ALL ( Fact_Sales ), ISBLANK ( RELATED ( Products[ProductName] ) ) ) ), "#,0" ),
			        6, FORMAT ( 0 + COUNTROWS ( FILTER ( ALL ( Fact_Inventory ), ISBLANK ( RELATED ( Products[ProductName] ) ) ) ), "#,0" ),
			        7, FORMAT ( 0 + COUNTROWS ( FILTER ( ALL ( Fact_Inventory ), Fact_Inventory[OnHandQty] < 0 ) ), "#,0" ),
			        8, FORMAT ( 0 + COUNTROWS ( FILTER ( ALL ( Fact_PurchaseOrders ), NOT ISBLANK ( Fact_PurchaseOrders[ReceivedDate] ) && Fact_PurchaseOrders[ReceivedDate] < Fact_PurchaseOrders[OrderDate] ) ), "#,0" ),
			        9, FORMAT ( 0 + COUNTROWS ( FILTER ( ALL ( Fact_PurchaseOrders ), Fact_PurchaseOrders[ReceivedQty] > Fact_PurchaseOrders[OrderedQty] ) ), "#,0" ),
			        10, FORMAT ( 0 + COUNTROWS ( FILTER ( ALL ( Fact_Sales ), Fact_Sales[UnitPrice] <= 0 ) ), "#,0" ),
			        11, FORMAT ( CALCULATE ( MAX ( Fact_Inventory[SnapshotDate] ), REMOVEFILTERS () ), "dd mmm yyyy" )
			    )
		displayFolder: Data Quality
		lineageTag: 16fa7588-192f-5c00-a4ca-41fd3cb071cb

	/// Pass / Fail / Info for each data quality rule.
	measure 'DQ Status' =
			VAR _o = SELECTEDVALUE ( Dim_DQ[Check Order] )
			VAR _v = [DQ Value]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _o ), BLANK (),
			        _o IN { 1, 2, 3, 11 }, "Info",
			        _v = "0", "Pass",
			        "Fail"
			    )
		displayFolder: Data Quality
		lineageTag: 2b62137e-7e01-5456-ad46-e0e2938c1a36

	measure 'DQ Status Pill' =
			VAR _t = [DQ Status]
			VAR _bg = SWITCH ( _t, "Pass", "#2E9E4F", "Info", "#A6A1D6", "#D9363E" )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='56' height='20' viewBox='0 0 56 20'>"
			        & "<rect x='1' y='2' width='54' height='16' rx='8' fill='" & _bg & "'/>"
			        & "<text x='28' y='14' text-anchor='middle' font-family='Segoe UI,sans-serif' font-size='10' font-weight='600' fill='#FFFFFF'>" & _t & "</text></svg>"
			RETURN
			    IF ( NOT ISBLANK ( _t ),
			        "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" ) )
		displayFolder: Data Quality
		lineageTag: da6b38eb-65f1-5d6a-95c9-cf360ca375df
		dataCategory: ImageUrl

	measure 'DQ Failed Checks' = COUNTROWS ( FILTER ( ALL ( Dim_DQ ), [DQ Status] = "Fail" ) )
		formatString: 0
		displayFolder: Data Quality
		lineageTag: d0fa7b8c-1ac2-5390-b8bf-55db02fcd8d4

	/// HTML summary for the Data Quality page.
	measure 'DQ Summary' =
			"<div style='font-family:Segoe UI,sans-serif;background:#100E6F;color:#E6E5F5;border-radius:12px;padding:12px 16px;box-sizing:border-box;height:100%;'><div style='font-size:12.5px;font-weight:700;margin:0 0 8px;color:#FFFFFF'>How this report is governed</div>"
			    & "<p style='font-size:12px;line-height:1.45;margin:0 0 7px'>" & ( "<b>Data quality:</b> " & IF ( [DQ Failed Checks] = 0, "all checks pass on the last refresh.", FORMAT ( [DQ Failed Checks], "0" ) & " check(s) failed on the last refresh." ) ) & "</p>"
			    & "<p style='font-size:12px;line-height:1.45;margin:0 0 7px'>" & ( "<b>Security:</b> the Warehouse Manager role uses a mapping table (Security_WarehouseAccess), so access is changed by editing data, not the model. Leadership sees every warehouse." ) & "</p>"
			    & "<p style='font-size:12px;line-height:1.45;margin:0 0 7px'>" & ( "<b>Definitions:</b> KPI measures carry descriptions and live in display folders; the full list is in Measure_Catalogue.md." ) & "</p>"
			    & "<p style='font-size:12px;line-height:1.45;margin:0 0 7px'>" & ( "<b>Freshness:</b> " & [Last Refresh] & "." ) & "</p>"
			    & "</div>"
		displayFolder: Data Quality
		lineageTag: fa6101c5-a996-5966-8c0a-0289962cb0c9

	/// Year in focus: the year picked in the slicer, or the latest year with sales.
	measure 'Selected Year' =
			VAR _maxYear = YEAR ( CALCULATE ( MAX ( Fact_Sales[OrderDate] ), ALL ( Fact_Sales ) ) )
			RETURN
			    IF ( ISFILTERED ( Dim_Date[Year] ), MAX ( Dim_Date[Year] ), _maxYear )
		formatString: 0
		displayFolder: Helpers
		lineageTag: 22a286bc-d699-5853-9525-e18e49638d75

	measure 'Last Snapshot Date' =
			CALCULATE (
			    MAX ( Fact_Inventory[SnapshotDate] ),
			    REMOVEFILTERS ( Products ),
			    REMOVEFILTERS ( Suppliers ),
			    REMOVEFILTERS ( Warehouses ),
			    REMOVEFILTERS ( Fact_Inventory[Inventory Health] ),
			    REMOVEFILTERS ( Fact_Inventory[Health Sort] ),
			    REMOVEFILTERS ( Fact_Inventory[Movement Class] ),
			    REMOVEFILTERS ( Fact_Inventory[Movement Sort] ),
			    REMOVEFILTERS ( Fact_Inventory[Stock Action] )
			)
		formatString: dd-mmm-yyyy
		displayFolder: Helpers
		lineageTag: c178dba0-c559-5776-b953-190121eca12b

	measure 'Filter Status' =
			VAR f =
			    ISFILTERED ( Products[Category] ) || ISFILTERED ( Suppliers[SupplierName] )
			        || ISFILTERED ( Warehouses[WarehouseName] ) || ISFILTERED ( Fact_Inventory[Inventory Health] )
			        || ISFILTERED ( Dim_Date[Year] ) || ISFILTERED ( Products[ProductName] )
			RETURN
			    IF ( f, "Filters applied!", "No filter applied!" )
		displayFolder: Helpers
		lineageTag: 6d505be4-49a7-5f8a-add0-4a2f31fa864b

	measure Greeting =
			VAR h = HOUR ( NOW () )
			RETURN
			    SWITCH ( TRUE (), h < 12, "Good Morning!", h < 17, "Good Afternoon!", "Good Evening!" )
		displayFolder: Helpers
		lineageTag: 7f4758c5-bf9f-5223-bdcd-11e79d58e35c

	measure 'Last Refresh' = "Last Refresh: " & FORMAT ( MAX ( _Refresh[RefreshedAt] ), "dd-MMM-yyyy" )
		displayFolder: Helpers
		lineageTag: 50de91e6-00ec-5745-9e7a-15beaba5b068

	/// Sales revenue: quantity × unit price.
	measure Revenue = SUM ( Fact_Sales[Revenue] )
		formatString: $#,0
		displayFolder: Sales
		lineageTag: 1173f78d-5b19-5838-8dde-7e1ae810e463

	/// Cost of goods sold: quantity × unit cost.
	measure COGS = SUM ( Fact_Sales[COGS] )
		formatString: $#,0
		displayFolder: Sales
		lineageTag: e149ecd3-5a3a-5574-8276-07a438379f67

	/// Revenue minus COGS.
	measure 'Gross Profit' = [Revenue] - [COGS]
		formatString: $#,0
		displayFolder: Sales
		lineageTag: 318c054f-0d7e-5d94-ad75-9e6846c03037

	/// Gross profit as a share of revenue.
	measure 'Margin %' = DIVIDE ( [Gross Profit], [Revenue] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 53f4070a-e559-5bb5-96f9-a3740f58b0a6

	/// Revenue in the year in focus.
	measure 'Revenue CY' =
			VAR _y = [Selected Year]
			RETURN
			    CALCULATE ( [Revenue], Dim_Date[Year] = _y )
		formatString: $#,0
		displayFolder: Sales
		lineageTag: aedfb0e2-ae90-5181-985d-e6ce1a63a973

	/// Revenue in the year before the year in focus.
	measure 'Revenue LY' =
			VAR _y = [Selected Year]
			RETURN
			    CALCULATE ( [Revenue], Dim_Date[Year] = _y - 1 )
		formatString: $#,0
		displayFolder: Sales
		lineageTag: 59b8c4e6-76f0-5fd1-9a23-afa9b00c3e2e

	/// Revenue growth vs the prior year.
	measure 'Revenue YoY %' = DIVIDE ( [Revenue CY] - [Revenue LY], [Revenue LY] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 4d581880-bccd-5857-aefa-e8426e2c91b3

	measure 'Revenue YoY Label' =
			VAR v = [Revenue YoY %]
			RETURN
			    IF ( ISBLANK ( v ), "–", FORMAT ( v, "+0.0%;-0.0%;0.0%" ) & IF ( v >= 0, " ▲", " ▼" ) )
		displayFolder: Sales
		lineageTag: 8f84631c-259f-595c-90d3-d46e2749f85b

	measure 'Revenue YoY Color' = IF ( [Revenue YoY %] >= 0, "#2E9E4F", "#D9363E" )
		displayFolder: Sales
		lineageTag: 6c3e8460-9ac5-5317-90b4-d56431a2dd77

	measure 'COGS CY' =
			VAR _y = [Selected Year]
			RETURN
			    CALCULATE ( [COGS], Dim_Date[Year] = _y )
		formatString: $#,0
		displayFolder: Sales
		lineageTag: a18f086c-cebd-5171-a0c3-0ba48b48c261

	measure 'Gross Profit CY' =
			VAR _y = [Selected Year]
			RETURN
			    CALCULATE ( [Gross Profit], Dim_Date[Year] = _y )
		formatString: $#,0
		displayFolder: Sales
		lineageTag: 2bf628c6-fb52-57a2-b678-70912faa3fb4

	measure 'Gross Profit LY' =
			VAR _y = [Selected Year]
			RETURN
			    CALCULATE ( [Gross Profit], Dim_Date[Year] = _y - 1 )
		formatString: $#,0
		displayFolder: Sales
		lineageTag: b822fc68-4ccb-5ceb-b9d0-8f1cd07cc7f3

	measure 'Gross Profit YoY %' = DIVIDE ( [Gross Profit CY] - [Gross Profit LY], [Gross Profit LY] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 37d0f909-0f16-509a-a34a-0d79f75a4a2d

	measure 'Gross Profit YoY Label' =
			VAR v = [Gross Profit YoY %]
			RETURN
			    IF ( ISBLANK ( v ), "–", FORMAT ( v, "+0.0%;-0.0%;0.0%" ) & IF ( v >= 0, " ▲", " ▼" ) )
		displayFolder: Sales
		lineageTag: 35bc4831-f9de-53b9-a0d0-d5e537e32b0f

	measure 'Gross Profit YoY Color' = IF ( [Gross Profit YoY %] >= 0, "#2E9E4F", "#D9363E" )
		displayFolder: Sales
		lineageTag: b0f380db-dc76-5c19-ab89-ef2e1a50d2d3

	measure 'Margin % CY' = DIVIDE ( [Gross Profit CY], [Revenue CY] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: cb226824-6377-5afc-9f90-224e1070afde

	measure 'Units Sold CY' =
			VAR _y = [Selected Year]
			RETURN
			    CALCULATE ( SUM ( Fact_Sales[Quantity] ), Dim_Date[Year] = _y )
		formatString: #,0
		displayFolder: Sales
		lineageTag: de1bf270-2c68-58e7-9f51-c83dd3ce4db0

	/// Stock value at cost on the last snapshot date in context.
	measure 'Inventory Value' =
			VAR _last = [Last Snapshot Date]
			RETURN
			    CALCULATE ( SUM ( Fact_Inventory[Inventory Value] ), Dim_Date[Date] = _last )
		formatString: $#,0
		displayFolder: Inventory
		lineageTag: 89b965e2-1c81-54e1-97c9-d3763d07441f

	/// Units on hand on the last snapshot date in context.
	measure 'Current Stock' =
			VAR _last = [Last Snapshot Date]
			RETURN
			    CALCULATE ( SUM ( Fact_Inventory[OnHandQty] ), Dim_Date[Date] = _last )
		formatString: #,0
		displayFolder: Inventory
		lineageTag: 9541c636-b977-515f-b93d-2281a8350a85

	measure 'Current Stock Action' =
			VAR _last = [Last Snapshot Date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( Fact_Inventory[Stock Action] ), Dim_Date[Date] = _last )
		displayFolder: Inventory
		lineageTag: af039166-6849-5761-8afb-46387f9bab80

	measure 'Current Health' =
			VAR _last = [Last Snapshot Date]
			RETURN
			    CALCULATE ( SELECTEDVALUE ( Fact_Inventory[Inventory Health] ), Dim_Date[Date] = _last )
		displayFolder: Inventory
		lineageTag: 256d2f52-5379-5c07-a0a6-05fe1fb0257c

	measure 'Current Days of Supply' =
			VAR _last = [Last Snapshot Date]
			RETURN
			    CALCULATE ( MAX ( Fact_Inventory[Days of Supply] ), Dim_Date[Date] = _last )
		formatString: #,0
		displayFolder: Inventory
		lineageTag: ef2baca6-28fd-51df-af25-74deca97190b

	measure 'Inventory Value CY' =
			VAR _y = [Selected Year]
			RETURN
			    CALCULATE ( [Inventory Value], Dim_Date[Year] = _y )
		formatString: $#,0
		displayFolder: Inventory
		lineageTag: 6a118fdb-aac8-5ae6-83e7-9ff4a364e33d

	measure 'Inventory Value LY' =
			VAR _y = [Selected Year]
			RETURN
			    CALCULATE ( [Inventory Value], Dim_Date[Year] = _y - 1 )
		formatString: $#,0
		displayFolder: Inventory
		lineageTag: 5d7d8a34-1c4b-5674-a665-dde74d929e3e

	measure 'Inventory Value YoY %' = DIVIDE ( [Inventory Value CY] - [Inventory Value LY], [Inventory Value LY] )
		formatString: 0.0%
		displayFolder: Inventory
		lineageTag: a808521d-c1e5-5cb0-b464-e3c3273a0b4e

	measure 'Inventory Value YoY Label' =
			VAR v = [Inventory Value YoY %]
			RETURN
			    IF ( ISBLANK ( v ), "–", FORMAT ( v, "+0.0%;-0.0%;0.0%" ) & IF ( v >= 0, " ▲", " ▼" ) )
		displayFolder: Inventory
		lineageTag: d74e9206-a2c4-503e-af05-478baac27140

	measure 'Inventory Value YoY Color' = IF ( [Inventory Value YoY %] >= 0, "#2E9E4F", "#D9363E" )
		displayFolder: Inventory
		lineageTag: 9c6e6bd1-daee-599d-bb6b-a40737745754

	measure 'Avg Inventory Value' = AVERAGEX ( VALUES ( Fact_Inventory[SnapshotDate] ), CALCULATE ( SUM ( Fact_Inventory[Inventory Value] ) ) )
		formatString: $#,0
		displayFolder: Inventory
		lineageTag: 22b1aecc-1a3a-52a4-be74-75bc7494729e

	/// Annualised COGS ÷ average inventory value.
	measure 'Inventory Turnover' = DIVIDE ( [COGS], [Avg Inventory Value] ) * DIVIDE ( 12, DISTINCTCOUNT ( Fact_Inventory[SnapshotDate] ) )
		formatString: 0.00
		displayFolder: Inventory
		lineageTag: 1d9675bd-ebf5-590e-93e8-f85711e8b2c0

	/// Inventory turnover in the year in focus.
	measure 'Inventory Turnover CY' =
			VAR _y = [Selected Year]
			RETURN
			    CALCULATE ( [Inventory Turnover], Dim_Date[Year] = _y )
		formatString: 0.00
		displayFolder: Inventory
		lineageTag: 9578129d-2ee7-5bbf-a72f-445331c81a34

	measure 'Inventory Turnover LY' =
			VAR _y = [Selected Year]
			RETURN
			    CALCULATE ( [Inventory Turnover], Dim_Date[Year] = _y - 1 )
		formatString: 0.00
		displayFolder: Inventory
		lineageTag: 819b4145-4b32-59a7-9ba5-e21d3f0369a8

	measure 'Inventory Turnover YoY %' = DIVIDE ( [Inventory Turnover CY] - [Inventory Turnover LY], [Inventory Turnover LY] )
		formatString: 0.0%
		displayFolder: Inventory
		lineageTag: fbac7087-7d9e-58ca-8dc8-c07862dd2234

	measure 'Inventory Turnover YoY Label' =
			VAR v = [Inventory Turnover YoY %]
			RETURN
			    IF ( ISBLANK ( v ), "–", FORMAT ( v, "+0.0%;-0.0%;0.0%" ) & IF ( v >= 0, " ▲", " ▼" ) )
		displayFolder: Inventory
		lineageTag: 136544bb-051f-590a-be97-a9565ab9968e

	measure 'Inventory Turnover YoY Color' = IF ( [Inventory Turnover YoY %] >= 0, "#2E9E4F", "#D9363E" )
		displayFolder: Inventory
		lineageTag: ee3676f1-40c3-59e1-b5c5-e57dd789a329

	/// Days inventory outstanding: 365 ÷ turnover.
	measure DIO = DIVIDE ( 365, [Inventory Turnover CY] )
		formatString: #,0.0
		displayFolder: Inventory
		lineageTag: fbe58360-01ea-5033-86c9-5cf0ba59c139

	measure 'DIO Color' = IF ( [DIO] > 30, "#D9363E", "#222222" )
		displayFolder: Inventory
		lineageTag: 1d61019e-eafd-5e79-a508-5ee2de0ae9d2

	measure 'DIO Note' = IF ( [DIO] > 30, "Slow turnover — excess stock risk", "Healthy turnover pace" )
		displayFolder: Inventory
		lineageTag: 52628835-e007-5a31-aa5d-c7551310a97c

	measure 'SKU Months' = COUNTROWS ( Fact_Inventory )
		formatString: #,0
		displayFolder: Stock Health
		lineageTag: fa4cb568-2ca5-59bb-9d7b-4a798f86999b

	measure 'Stockout Count' = CALCULATE ( COUNTROWS ( Fact_Inventory ), Fact_Inventory[OnHandQty] <= 0 ) + 0
		formatString: #,0
		displayFolder: Stock Health
		lineageTag: 73234bf2-0966-503b-a0aa-ea5eb9d11961

	/// Share of SKU-months with zero or negative stock.
	measure 'Stockout Rate %' = DIVIDE ( CALCULATE ( COUNTROWS ( Fact_Inventory ), Fact_Inventory[OnHandQty] <= 0 ) + 0, COUNTROWS ( Fact_Inventory ) )
		formatString: 0.0%
		displayFolder: Stock Health
		lineageTag: 2c4798f8-cd63-5d63-a64b-4af5dc5fd5ce

	/// Stockout rate in the year in focus.
	measure 'Stockout Rate CY' =
			VAR _y = [Selected Year]
			RETURN
			    CALCULATE ( [Stockout Rate %], Dim_Date[Year] = _y )
		formatString: 0.0%
		displayFolder: Stock Health
		lineageTag: 343a11d2-8394-5a9d-bfc0-a438bf848527

	measure 'Stockout Rate LY' =
			VAR _y = [Selected Year]
			RETURN
			    CALCULATE ( [Stockout Rate %], Dim_Date[Year] = _y - 1 )
		formatString: 0.0%
		displayFolder: Stock Health
		lineageTag: 8fdbc254-cb4d-5f9f-b5ec-70e7de6ae07e

	measure 'Stockout Rate YoY %' = DIVIDE ( [Stockout Rate CY] - [Stockout Rate LY], [Stockout Rate LY] )
		formatString: 0.0%
		displayFolder: Stock Health
		lineageTag: 1f59d5c6-c0bc-5132-8d25-480d615df9ac

	measure 'Stockout Rate YoY Label' =
			VAR v = [Stockout Rate YoY %]
			RETURN
			    IF ( ISBLANK ( v ), "–", FORMAT ( v, "+0.0%;-0.0%;0.0%" ) & IF ( v >= 0, " ▲", " ▼" ) )
		displayFolder: Stock Health
		lineageTag: 51176896-e16f-5257-b580-8e676ef74f27

	measure 'Stockout Rate YoY Color' = IF ( [Stockout Rate YoY %] >= 0, "#D9363E", "#2E9E4F" )
		displayFolder: Stock Health
		lineageTag: f2a7a4a2-c9ed-5867-b523-be4163ba53eb

	measure 'Stockout Count Note' = "Out of " & FORMAT ( [SKU Months], "#,0" ) & " SKU-months tracked"
		displayFolder: Stock Health
		lineageTag: 13c3df09-89dd-56ab-a073-9785662bda30

	/// SKUs with stock recorded on the last snapshot.
	measure 'Active SKUs' = COUNTROWS ( FILTER ( VALUES ( Products[SKU] ), NOT ISBLANK ( [Current Stock] ) ) )
		formatString: #,0
		displayFolder: Stock Health
		lineageTag: 9a21ec83-7436-54cc-8aa2-5161561232a3

	/// SKUs at or below their reorder point on the last snapshot.
	measure 'Low Stock SKUs' = COUNTROWS ( FILTER ( VALUES ( Products[SKU] ), [Current Stock Action] = "Reorder Now" ) ) + 0
		formatString: #,0
		displayFolder: Stock Health
		lineageTag: 17b34a73-0a2d-5d7e-a74a-9d6f89e97114

	measure 'Low Stock Note' = FORMAT ( DIVIDE ( [Low Stock SKUs], [Active SKUs] ), "0%" ) & " of catalog needs reorder"
		displayFolder: Stock Health
		lineageTag: 5674ac95-a036-5a03-b003-3934546dd1a1

	/// Average days the current stock lasts at the current sales rate (capped at 365).
	measure 'Avg Days of Supply' = AVERAGE ( Fact_Inventory[Days of Supply] )
		formatString: #,0.0
		displayFolder: Stock Health
		lineageTag: 86db8565-c543-5144-b5a5-b3c52fe771f1

	measure 'Avg Days of Supply Note' =
			VAR v = [Avg Days of Supply]
			RETURN
			    SWITCH ( TRUE (), v > 40, "Avg. above target (30–40 days)", v < 30, "Avg. below target (30–40 days)", "Within target (30–40 days)" )
		displayFolder: Stock Health
		lineageTag: 0eceed98-5d1c-58b5-8ecd-48b94bc2503e

	measure 'Units Received' = SUM ( Fact_Inventory[UnitsReceived] )
		formatString: #,0
		displayFolder: Stock Health
		lineageTag: 191441af-c496-5716-a670-5d93a07a9d21

	measure 'Units Sold (Stock)' = SUM ( Fact_Inventory[UnitsSold] )
		formatString: #,0
		displayFolder: Stock Health
		lineageTag: 272058c7-0028-529d-8f11-88b542e74f1e

	measure 'Units Received Note' = "Across " & DISTINCTCOUNT ( Fact_Inventory[SnapshotDate] ) & " months: " & CALCULATE ( DISTINCTCOUNT ( Fact_Inventory[SKU] ), Fact_Inventory[UnitsReceived] > 0 ) & " SKUs restocked"
		displayFolder: Stock Health
		lineageTag: 9063beb4-6bd9-54d6-99e0-7d08ea71695d

	/// Cost to reorder every low-stock SKU at its reorder quantity.
	measure 'Restock Cost' =
			SUMX (
			    FILTER ( VALUES ( Products[SKU] ), [Current Stock Action] = "Reorder Now" ),
			    CALCULATE ( MAX ( Products[ReorderQty] ) * MAX ( Products[UnitCost] ) )
			)
		formatString: $#,0
		displayFolder: Stock Health
		lineageTag: 96dc7023-335e-5632-815b-da8902c0fbc1

	measure 'Restock Cost Note' = "To restock " & [Low Stock SKUs] & " SKUs now"
		displayFolder: Stock Health
		lineageTag: 7152273d-3e11-5ee9-a0b9-1119566fa4ff

	measure 'Restock Cost Note (Detail)' = "To restock " & [Low Stock SKUs] & " low stock SKUs"
		displayFolder: Stock Health
		lineageTag: 43f4d7de-7af9-54ee-9d52-b8fecfe8f1ff

	measure 'Reorder Point (SKU)' = IF ( NOT ISBLANK ( [Current Stock] ), SUM ( Products[ReorderPoint] ) )
		formatString: #,0
		displayFolder: Stock Health
		lineageTag: 7639802e-757e-5c8a-aea6-acdd3bc1874f

