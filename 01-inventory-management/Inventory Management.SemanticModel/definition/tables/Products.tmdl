	partition Products = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFilePath), null, true),
				    Sheet = Source{[Item="Products",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"SKU", "ProductName", "Category", "SupplierID", "WarehouseID", "UnitCost", "UnitPrice", "LeadTimeDays", "ReorderPoint", "ReorderQty"}),
				    NonBlank = Table.SelectRows(Selected, each [SKU] <> null and [SKU] <> ""),
				    Typed = Table.TransformColumnTypes(NonBlank, {{"SKU", type text}, {"ProductName", type text}, {"Category", type text}, {"SupplierID", type text}, {"WarehouseID", type text}, {"UnitCost", type number}, {"UnitPrice", type number}, {"LeadTimeDays", Int64.Type}, {"ReorderPoint", Int64.Type}, {"ReorderQty", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table

