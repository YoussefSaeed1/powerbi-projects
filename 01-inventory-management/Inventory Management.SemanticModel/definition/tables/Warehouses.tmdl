		summarizeBy: none
		sourceColumn: Region

		annotation SummarizationSetBy = Automatic

	partition Warehouses = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFilePath), null, true),
				    Sheet = Source{[Item="Warehouses",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"WarehouseID", "WarehouseName", "Region"}),
				    NonBlank = Table.SelectRows(Selected, each [WarehouseID] <> null and [WarehouseID] <> ""),
				    Typed = Table.TransformColumnTypes(NonBlank, {{"WarehouseID", type text}, {"WarehouseName", type text}, {"Region", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

