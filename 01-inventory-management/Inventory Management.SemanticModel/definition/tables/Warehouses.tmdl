table Warehouses
	lineageTag: 37d8a6cb-0c2d-5764-ae50-4c5c3b3d6c21

	column WarehouseID
		dataType: string
		isKey
		lineageTag: d532e0e7-6ffb-5c66-a4af-e0646e051650
		summarizeBy: none
		sourceColumn: WarehouseID

		annotation SummarizationSetBy = Automatic

	column WarehouseName
		dataType: string
		lineageTag: 7a724faf-fe64-50b5-a4d9-2985d8a9113c
		summarizeBy: none
		sourceColumn: WarehouseName

