table Dim_Category
	lineageTag: a4a28eb5-e6f2-596b-bef3-4624ac975974

	column Category
		dataType: string
		isKey
		lineageTag: fc02c592-f28e-5079-823d-59cf57bb77d7
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = Automatic

	partition Dim_Category = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFilePath), null, true),
				    Sheet = Source{[Item="Categories",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"Category"}),
				    NonBlank = Table.SelectRows(Selected, each [Category] <> null and [Category] <> ""),
				    Typed = Table.TransformColumnTypes(NonBlank, {{"Category", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
