table Dim_Product
	lineageTag: a06c5ec4-7102-576f-80ac-da6a95d690c2

	column ProductKey
		dataType: int64
		isHidden
		isKey
		formatString: 0
		lineageTag: bb023799-6ac5-5d12-bb2f-9df6c046ed77
		summarizeBy: none
		sourceColumn: ProductKey

		annotation SummarizationSetBy = Automatic

	column ProductName
		dataType: string
		lineageTag: dc4219ed-fc40-52a5-ad37-f5c638e92bfa
		summarizeBy: none
		sourceColumn: ProductName

		annotation SummarizationSetBy = Automatic

	column Category
		dataType: string
		isHidden
		lineageTag: 1410db5e-eb39-564e-ad44-b536e6cc7f8c
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = Automatic

	column Brand
		dataType: string
		lineageTag: a697b4d9-3873-58ec-88ab-ebae70c54576
		summarizeBy: none
		sourceColumn: Brand

		annotation SummarizationSetBy = Automatic

	partition Dim_Product = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFilePath), null, true),
				    Sheet = Source{[Item="Products",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"ProductKey", "ProductName", "Category", "Brand"}),
				    NonBlank = Table.SelectRows(Selected, each [ProductKey] <> null and [ProductKey] <> ""),
				    Typed = Table.TransformColumnTypes(NonBlank, {{"ProductKey", Int64.Type}, {"ProductName", type text}, {"Category", type text}, {"Brand", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
