table Dim_Geography
	lineageTag: f89e05b6-4826-5432-ab77-b232395a89b3

	column Country
		dataType: string
		isKey
		lineageTag: 9d33dea1-2c60-569d-ae54-75b9c25c736d
		summarizeBy: none
		sourceColumn: Country

		annotation SummarizationSetBy = Automatic

	column Region
		dataType: string
		lineageTag: 64d48240-2b3a-5a84-86a5-4e3933bc8094
		summarizeBy: none
		sourceColumn: Region

		annotation SummarizationSetBy = Automatic

	partition Dim_Geography = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFilePath), null, true),
				    Sheet = Source{[Item="Geography",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"Country", "Region"}),
				    NonBlank = Table.SelectRows(Selected, each [Country] <> null and [Country] <> ""),
				    Typed = Table.TransformColumnTypes(NonBlank, {{"Country", type text}, {"Region", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
