/// Time of the last data refresh (shown in the report footer and the data quality page).
table _Refresh
	lineageTag: 2235c6a0-8524-5996-a9e4-b9555ad71121
	isHidden

	column RefreshedAt
		dataType: dateTime
		isHidden
		formatString: dd-mmm-yyyy hh:nn
		lineageTag: f478f5c0-0346-5ac0-ad73-9729e39beefc
		summarizeBy: none
		sourceColumn: RefreshedAt

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition _Refresh = m
		mode: import
		source =
				let
				    Source = #table(type table [RefreshedAt = datetime], {{DateTime.LocalNow()}})
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
