/// Sales regions and their area manager. ManagerEmail drives row-level security; replace the example addresses with real sign-ins.
table Dim_Region
	lineageTag: cbd43959-c144-53a1-85ea-0e45144ddfd8

	column Region
		dataType: string
		isKey
		lineageTag: a6bff74b-2db7-5013-ab57-21cbed664ab7
		summarizeBy: none
		sourceColumn: Region

		annotation SummarizationSetBy = Automatic

	column Manager
		dataType: string
		lineageTag: 3d1c49e6-475d-5918-855e-9a7f307667c2
		summarizeBy: none
		sourceColumn: Manager

		annotation SummarizationSetBy = Automatic

	column 'Region Label'
		dataType: string
		lineageTag: cf261924-f3c0-5c79-beea-44bacb972af6
		summarizeBy: none
		sourceColumn: Region Label

		annotation SummarizationSetBy = Automatic

	column ManagerEmail
		dataType: string
		isHidden
		lineageTag: d393a1de-fa63-53c9-ab16-06fe3a6f0f5f
		summarizeBy: none
		sourceColumn: ManagerEmail

		annotation SummarizationSetBy = Automatic

	partition Dim_Region = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFilePath), null, true),
				    Sheet = Source{[Item="Area managers",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Region", type text}, {"Manager", type text}}),
				    Label = Table.AddColumn(Typed, "Region Label", each [Region] & " (" & [Manager] & ")", type text),
				    Email = Table.AddColumn(Label, "ManagerEmail", each Text.Lower([Manager]) & "@example.com", type text)
				in
				    Email

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
